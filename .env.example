# Configuration Firebase cote client.
#
# Ces valeurs ne sont PAS des secrets : elles partent dans le navigateur. La
# protection reelle des donnees, ce sont les regles Firestore (firestore.rules).
# Elles vivent quand meme ici pour que dev, staging et prod visent trois projets
# Firebase distincts (SECURITY.md SS2).
#
# Copier ce fichier vers .env.local, qui est gitignore.

# Mettre a 1 pour parler aux emulateurs locaux plutot qu'a un projet Firebase.
NEXT_PUBLIC_FIREBASE_EMULATEURS=1

NEXT_PUBLIC_FIREBASE_API_KEY=cle-factice-emulateur
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=sdi-dev.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=sdi-dev
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=sdi-dev.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000
