rules_version = '2';

/*
  Règles Firestore.

  Principe non négociable, posé dès la première ligne : refus par défaut, et
  aucun accès direct pour un utilisateur non authentifié (SECURITY.md §1 et §4,
  prompt.md §16). Les pages publiques client et prestataire ne feront jamais
  d'exception ici : elles passeront par l'Admin SDK côté serveur.

  Chaque spec ajoute ses propres règles avec ses tests. S12 est la passe de
  durcissement d'ensemble — pas le moment où l'on commence à écrire ce fichier.
*/

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Fonctions d'aide -------------------------------------------------
    // Le rôle est lu dans le custom claim, jamais dans un document : un rôle
    // stocké dans une collection modifiable serait un rôle qu'on peut se
    // donner soi-même.

    function connecte() {
      return request.auth != null;
    }

    // `get(cle, defaut)` et non `token.role`, et la raison est mesurée, pas
    // supposée. Lire une clé absente d'une map fait bien planter l'évaluation :
    // le moteur répond « Property role is undefined on object ». Mais un
    // plantage n'abat pas toute l'expression — un `||` le rattrape et la
    // branche suivante décide. C'est pourquoi le défaut est resté invisible :
    // presque partout ici, un OU couvre la lecture du jeton.
    //
    // Il mord là où les deux branches lisent le jeton. `boutiques/{code}` est
    // ce cas. Avant, un compte sans claim y recevait, dans son navigateur :
    //
    //   Property role is undefined on object. for 'get' @ L87,
    //   false for 'get' @ L159, false for 'get' @ L855
    //
    // Trois choses ne vont pas là-dedans. Le refus est un plantage, donc rendu
    // pour la mauvaise raison. Le nom de la clé manquante sort des règles et
    // arrive chez le client. Et trois règles sont citées pour une décision,
    // dont le joker des référentiels (L159) qui n'avait rien à voir. Depuis,
    // le même appel rend :
    //
    //   false for 'get' @ L106, false for 'get' @ L909
    //
    // — la règle des boutiques, et le refus par défaut. Une décision, et sa
    // cause. `regles/utilisateurs.test.ts` fige le premier point.
    //
    // Le cas n'est pas d'école : entre la création d'un compte et la pose de
    // ses claims par la Cloud Function il s'écoule un instant réel, et c'est
    // celui où l'application demande « où suis-je ».
    function role() {
      return request.auth.token.get('role', '');
    }

    // La boutique du compte, ou la chaîne vide s'il n'en a pas. Vide ne
    // correspond à aucun code de boutique — le refus est donc une décision.
    function boutiqueDuCompte() {
      return request.auth.token.get('boutiqueId', '');
    }

    function estResponsable() {
      return connecte() && role() == 'responsable';
    }

    // --- Comptes utilisateurs (S2) ---------------------------------------
    // `users/{uid}` est un **miroir** lisible du compte, pas la source des
    // droits. Personne ne l'écrit depuis un navigateur : seules les Cloud
    // Functions y touchent, via le SDK Admin qui ne passe pas par ces règles.
    // C'est ce qui rend structurellement impossible de se promouvoir
    // responsable ou de se rattacher à une autre boutique.
    match /users/{uid} {
      allow read: if estResponsable() || (connecte() && request.auth.uid == uid);
      allow create, update, delete: if false;
    }

    // --- Boutiques (S3) ---------------------------------------------------
    // L'identifiant du document EST le code de la boutique. Firestore ne sait
    // pas imposer l'unicité d'un champ ; en faire la clé la donne gratuitement,
    // et le code entre dans les numéros de reçus (D5) donc il ne bouge jamais.
    //
    // Le gérant ne lit que la sienne : c'est la seule dont il ait besoin, et en
    // cas de doute on expose le moins (SECURITY.md §0, cf. D7).

    function texteBorne(valeur, maximum) {
      return valeur is string && valeur.size() <= maximum;
    }

    // Les metiers disent ce que la boutique vend (D62). Le champ est exige a
    // l'ecriture : une boutique sans metier n'ouvre aucun espace, et son gerant
    // se connecterait sur une application vide sans rien pouvoir y corriger.
    function boutiqueValide(donnees, code) {
      return donnees.keys().hasOnly(['nom', 'code', 'metiers', 'adresse', 'telephone', 'actif',
                                     'createdAt', 'createdBy', 'createdByName',
                                     'updatedAt', 'updatedBy', 'updatedByName'])
             && donnees.keys().hasAll(['nom', 'code', 'metiers', 'adresse', 'telephone', 'actif',
                                       'createdAt', 'createdBy', 'createdByName',
                                       'updatedAt', 'updatedBy', 'updatedByName'])
             && donnees.code == code
             && donnees.code.matches('^[A-Z]{3}$')
             && donnees.nom is string
             && donnees.nom.size() > 0
             && donnees.nom.size() <= 80
             && donnees.metiers is list
             && donnees.metiers.size() > 0
             && donnees.metiers.size() <= 2
             && donnees.metiers.hasOnly(['motos', 'pieces'])
             && texteBorne(donnees.adresse, 200)
             && texteBorne(donnees.telephone, 40)
             && texteBorne(donnees.createdByName, 200)
             && texteBorne(donnees.updatedByName, 200)
             && donnees.actif is bool
             && donnees.createdBy is string
             && donnees.updatedBy is string;
    }

    match /boutiques/{code} {
      allow read: if estResponsable()
                  || (connecte() && boutiqueDuCompte() == code);

      allow create: if estResponsable()
                    && boutiqueValide(request.resource.data, code)
                    && request.resource.data.createdAt == request.time
                    && request.resource.data.updatedAt == request.time
                    && request.resource.data.createdBy == request.auth.uid;

      // Le code et la date de création ne bougent pas. C'est aussi ce qui
      // empêche une « création » de recouvrir une boutique existante : le
      // formulaire enverrait un createdAt neuf, refusé ici.
      //
      // Les métiers, eux, se modifient : une boutique peut se mettre aux pièces,
      // et rien de ce qui est déjà imprimé n'en dépend (D62).
      allow update: if estResponsable()
                    && boutiqueValide(request.resource.data, code)
                    && request.resource.data.code == resource.data.code
                    && request.resource.data.createdAt == resource.data.createdAt
                    && request.resource.data.createdBy == resource.data.createdBy
                    && request.resource.data.updatedAt == request.time
                    && request.resource.data.updatedBy == request.auth.uid;

      // Une boutique ne se supprime pas : des ventes et des numéros de reçus
      // portent son code. On la ferme, elle reste lisible.
      allow delete: if false;
    }

    // --- Référentiels et entreprise (S4) -----------------------------------
    // Tout le monde lit, seul le responsable écrit. Le gérant a besoin de ces
    // listes pour saisir une moto ou déposer un dossier, et des coordonnées de
    // l'entreprise pour imprimer un reçu — y compris hors ligne, d'où le fait
    // que le logo voyage dans le document plutôt que dans Storage (D35).
    //
    // Rien ne se supprime : une marque, une provenance, un prestataire sont
    // cités par des motos et des dossiers. On les désactive.

    function traceCreation(donnees) {
      return donnees.createdAt == request.time
             && donnees.updatedAt == request.time
             && donnees.createdBy == request.auth.uid
             && donnees.updatedBy == request.auth.uid
             && texteBorne(donnees.createdByName, 200)
             && texteBorne(donnees.updatedByName, 200);
    }

    function traceModification(donnees, ancien) {
      return donnees.updatedAt == request.time
             && donnees.updatedBy == request.auth.uid
             && texteBorne(donnees.updatedByName, 200)
             && donnees.createdAt == ancien.createdAt
             && donnees.createdBy == ancien.createdBy;
    }

    function champsAudit() {
      return ['createdAt', 'createdBy', 'createdByName', 'updatedAt', 'updatedBy', 'updatedByName'];
    }

    function nomBorne(valeur) {
      return valeur is string && valeur.size() > 0 && valeur.size() <= 60;
    }

    function referentielValide(donnees) {
      return donnees.keys().hasOnly(['nom', 'actif'].concat(champsAudit()))
             && donnees.keys().hasAll(['nom', 'actif'].concat(champsAudit()))
             && nomBorne(donnees.nom)
             && donnees.actif is bool;
    }

    // Les trois référentiels de même forme : un nom, un état.
    //
    // **Trois blocs nommés, et non un joker.** Ils étaient écrits en un seul
    // `match` à segment variable, avec la liste des noms autorisés à
    // l'intérieur. C'était correct — la liste refusait tout le reste — mais un
    // joker à la racine s'interpose sur **toutes** les collections du produit :
    // ventes, motos, clients, boutiques, chacune voyait aussi ce bloc
    // s'évaluer et répondre `false`. Rien n'était accordé de trop, l'accès
    // étant accordé dès qu'une règle dit oui ; mais chaque refus du produit
    // citait ces lignes-ci. On y cherchait la règle qui avait décidé, on
    // tombait sur le joker, et le diagnostic partait sur les référentiels
    // quand la question portait sur les ventes. S30 a coûté du temps ainsi :
    // les règles y ont été accusées à tort.
    //
    // Trois chemins écrits en toutes lettres : chaque collection ne voit plus
    // que ses propres règles, et un refus nomme sa cause. La répétition est le
    // prix, et il est bon — trois blocs de sept lignes contre un joker qui
    // brouille la lecture des refus de tout le produit.
    // **Créer, oui ; renommer et désactiver, non** (S39). Ajouter un mot au
    // vocabulaire de la maison est un geste de comptoir : le gérant à qui il
    // manque « Apsonic » un samedi matin le tape sur le formulaire d'entrée en
    // stock, au lieu d'attendre un appel. Une entrée de trop se désactive.
    //
    // Changer un mot déjà employé est un autre geste : le stock, les ventes et
    // les reçus le citent, et le renommage se propage partout d'un coup. Il
    // reste au responsable.
    //
    // `typesFrais` ne suit pas : il n'alimente que le bloc des coûts, que le
    // gérant ne voit plus depuis S39.
    match /marques/{id} {
      allow read: if connecte();
      allow create: if connecte()
                    && referentielValide(request.resource.data)
                    && traceCreation(request.resource.data);
      allow update: if estResponsable()
                    && referentielValide(request.resource.data)
                    && traceModification(request.resource.data, resource.data);
      allow delete: if false;
    }

    match /provenances/{id} {
      allow read: if connecte();
      allow create: if connecte()
                    && referentielValide(request.resource.data)
                    && traceCreation(request.resource.data);
      allow update: if estResponsable()
                    && referentielValide(request.resource.data)
                    && traceModification(request.resource.data, resource.data);
      allow delete: if false;
    }

    match /typesFrais/{id} {
      allow read: if connecte();
      allow create: if estResponsable()
                    && referentielValide(request.resource.data)
                    && traceCreation(request.resource.data);
      allow update: if estResponsable()
                    && referentielValide(request.resource.data)
                    && traceModification(request.resource.data, resource.data);
      allow delete: if false;
    }

    // Un modèle appartient à une marque, et la marque doit exister : un modèle
    // orphelin apparaîtrait dans une liste de choix sans qu'on sache de quelle
    // marque il est.
    function modeleValide(donnees) {
      return donnees.keys().hasOnly(['nom', 'actif', 'marqueId'].concat(champsAudit()))
             && donnees.keys().hasAll(['nom', 'actif', 'marqueId'].concat(champsAudit()))
             && nomBorne(donnees.nom)
             && donnees.actif is bool
             && donnees.marqueId is string
             && exists(/databases/$(database)/documents/marques/$(donnees.marqueId));
    }

    match /modeles/{id} {
      allow read: if connecte();
      // Comme les marques (S39) : un modèle inconnu se tape au comptoir. La
      // marque citée doit exister — hors ligne, la file d'écritures rejoue dans
      // l'ordre, donc la marque créée juste avant sera là quand ceci arrive.
      allow create: if connecte()
                    && modeleValide(request.resource.data)
                    && traceCreation(request.resource.data);
      allow update: if estResponsable()
                    && modeleValide(request.resource.data)
                    && request.resource.data.marqueId == resource.data.marqueId
                    && traceModification(request.resource.data, resource.data);
      allow delete: if false;
    }

    // Le champ « token » du cahier des charges n'est pas au contrat : il donne
    // accès à une page publique, et un secret ne se fabrique pas dans un
    // navigateur. Il viendra d'une Cloud Function en S15.
    function prestataireValide(donnees) {
      return donnees.keys().hasOnly(['nom', 'telephone', 'typesDocuments', 'actif'].concat(champsAudit()))
             && donnees.keys().hasAll(['nom', 'telephone', 'typesDocuments', 'actif'].concat(champsAudit()))
             && nomBorne(donnees.nom)
             && donnees.telephone is string
             && donnees.telephone.size() > 0
             && donnees.telephone.size() <= 40
             && donnees.typesDocuments is list
             && donnees.typesDocuments.size() > 0
             && donnees.typesDocuments.hasOnly(['carte_grise', 'plaque'])
             && donnees.actif is bool;
    }

    match /prestataires/{id} {
      allow read: if connecte();
      allow create: if estResponsable()
                    && prestataireValide(request.resource.data)
                    && traceCreation(request.resource.data);
      allow update: if estResponsable()
                    && prestataireValide(request.resource.data)
                    && traceModification(request.resource.data, resource.data);
      allow delete: if false;
    }

    // Le document `entreprise/profil` ne porte plus l'identité de l'entreprise :
    // raison sociale, siège, téléphone, IFU, RCCM et logo sont une constante du
    // code depuis D71. Une donnée qui ne change jamais n'a rien à faire dans une
    // collection modifiable — surtout quand elle s'imprime sur un document
    // commercial et qu'un champ vidé produirait des reçus non conformes sans
    // que rien n'alerte.
    //
    // Il ne reste donc qu'un entier, et la règle le dit : tout autre champ est
    // refusé. Les fiches écrites avant cette décision portent encore les anciens
    // champs ; l'application les remplace entièrement à la première sauvegarde
    // (écriture sans `merge`, cf. `lib/repositories/entreprise.ts`), parce qu'en
    // fusion la règle verrait le document résultant et refuserait ce qu'il reste.
    function entrepriseValide(donnees) {
      return donnees.keys().hasOnly(['seuilInactiviteTranches',
                                     'updatedAt', 'updatedBy', 'updatedByName'])
             // Le seuil d'inactivité des tranches (S9, §6.3). Facultatif :
             // les fiches saisies avant S9 n'en ont pas, et le défaut de
             // trente jours prend le relais côté application.
             && (!donnees.keys().hasAny(['seuilInactiviteTranches'])
                 || (donnees.seuilInactiviteTranches is int
                     && donnees.seuilInactiviteTranches >= 1
                     && donnees.seuilInactiviteTranches <= 365))
             && donnees.updatedAt == request.time
             && donnees.updatedBy == request.auth.uid
             && texteBorne(donnees.updatedByName, 200);
    }

    match /entreprise/{document} {
      allow read: if connecte();
      allow create, update: if estResponsable()
                            && document == 'profil'
                            && entrepriseValide(request.resource.data);
      allow delete: if false;
    }

    // --- Stock motos (S5) ---------------------------------------------------
    // Le document est coupé en deux, et la coupure est la règle de sécurité
    // elle-même : `motos/{id}` est lisible par le gérant de la boutique,
    // `motos/{id}/prive/cout` par le seul responsable. Firestore ne sait pas
    // masquer un champ ; c'est la seule façon de tenir le §8 du cahier des
    // charges — la marge est réservée au responsable — tout en laissant le
    // gérant lire la moto pour la vendre (D2).
    //
    // Le gérant écrit le coût sans jamais pouvoir le relire (D4) : une moto qui
    // arrive au comptoir doit se saisir sans attendre le responsable.

    function estGerantDe(boutiqueId) {
      return connecte() && role() == 'gerant' && boutiqueDuCompte() == boutiqueId;
    }

    function montantValide(valeur) {
      return valeur is int && valeur >= 0 && valeur <= 1000000000;
    }

    // Un chemin de fichier absent ou nul est normal : le scan s'ajoute plus tard.
    function cheminFichier(donnees, champ) {
      return !donnees.keys().hasAny([champ])
             || donnees[champ] == null
             || texteBorne(donnees[champ], 300);
    }

    function motoValide(donnees) {
      return donnees.keys().hasOnly(['boutiqueId', 'etat', 'marqueId', 'modeleId', 'couleur',
                                     'annee', 'numeroChassis', 'numeroMoteur',
                                     'prixVenteConseille', 'provenanceId', 'papiersFournis',
                                     'photos', 'statut', 'dateEntree',
                                     'quittanceChemin', 'cmcChemin'].concat(champsAudit()))
             && donnees.keys().hasAll(['boutiqueId', 'etat', 'marqueId', 'modeleId',
                                       'numeroChassis', 'provenanceId', 'photos', 'statut',
                                       'dateEntree'].concat(champsAudit()))
             && donnees.boutiqueId is string
             && donnees.etat in ['neuve', 'occasion']
             && donnees.statut in ['en_stock', 'reservee', 'vendue', 'transferee']
             && donnees.marqueId is string
             && donnees.marqueId.size() > 0
             && donnees.modeleId is string
             && donnees.modeleId.size() > 0
             && donnees.provenanceId is string
             && donnees.provenanceId.size() > 0
             && donnees.numeroChassis is string
             && donnees.numeroChassis.size() > 0
             && donnees.numeroChassis.size() <= 32
             && donnees.numeroChassis.matches('^[A-Z0-9]+$')
             && texteBorne(donnees.numeroMoteur, 32)
             && texteBorne(donnees.couleur, 60)
             && (donnees.annee == null
                 || (donnees.annee is int && donnees.annee >= 1950 && donnees.annee <= 2100))
             && (donnees.prixVenteConseille == null || montantValide(donnees.prixVenteConseille))
             && donnees.papiersFournis is list
             && donnees.papiersFournis.size() <= 20
             // Les photos arrivent avec S19 : la liste existe et reste vide.
             && donnees.photos is list
             && donnees.photos.size() == 0
             // Les scans de la quittance et du CMC (S11, D66). Absents a la
             // creation : ils s'ajoutent quand il y a du reseau, et le
             // formulaire s'enregistre sans eux. Ce sont des chemins Storage,
             // pas des URL : l'URL se redemande a chaque lecture et expire.
             && cheminFichier(donnees, 'quittanceChemin')
             && cheminFichier(donnees, 'cmcChemin')
             // La date d'entrée vient de l'appareil (D38), on la borne seulement
             // contre une horloge déréglée.
             && donnees.dateEntree is timestamp
             && donnees.dateEntree <= request.time + duration.value(1, 'd');
    }

    match /motos/{motoId} {
      allow read: if estResponsable() || estGerantDe(resource.data.boutiqueId);

      allow create: if motoValide(request.resource.data)
                    && traceCreation(request.resource.data)
                    && request.resource.data.statut == 'en_stock'
                    && (estResponsable() || estGerantDe(request.resource.data.boutiqueId));

      // La boutique d'une moto ne change pas ici : c'est un transfert, et le
      // transfert a sa propre spec (S17) parce qu'il laisse une trace.
      allow update: if motoValide(request.resource.data)
                    && traceModification(request.resource.data, resource.data)
                    && request.resource.data.boutiqueId == resource.data.boutiqueId
                    && (estResponsable() || estGerantDe(resource.data.boutiqueId));

      allow delete: if false;
    }

    // Le coût. Le `boutiqueId` y est répété : au sein d'un même lot d'écriture,
    // les règles évaluent chaque document contre l'état d'avant, donc la moto
    // parente n'existe pas encore quand son coût est validé. On vérifie donc le
    // claim directement, et le parent en plus dès qu'il existe.
    //
    // Limite assumée : les règles ne savent pas parcourir une liste, donc ni la
    // forme de chaque ligne de frais ni l'égalité coutTotal = prixAchat + frais
    // ne sont vérifiées ici. C'est le domaine qui les tient, et le responsable
    // voit le détail à côté du total.
    function coutValide(donnees) {
      return donnees.keys().hasOnly(['boutiqueId', 'prixAchat', 'fraisEntree', 'coutTotal',
                                     'updatedAt', 'updatedBy', 'updatedByName'])
             && donnees.keys().hasAll(['boutiqueId', 'prixAchat', 'fraisEntree', 'coutTotal',
                                       'updatedAt', 'updatedBy', 'updatedByName'])
             && donnees.boutiqueId is string
             && montantValide(donnees.prixAchat)
             && montantValide(donnees.coutTotal)
             && donnees.fraisEntree is list
             && donnees.fraisEntree.size() <= 20
             && donnees.updatedAt == request.time
             && donnees.updatedBy == request.auth.uid
             && texteBorne(donnees.updatedByName, 200);
    }

    function boutiqueDeLaMoto(motoId) {
      return get(/databases/$(database)/documents/motos/$(motoId)).data.boutiqueId;
    }

    // **Le responsable seul écrit ici, depuis S39.** Le gérant y avait accès en
    // écriture — il saisissait le prix d'achat à l'entrée en stock sans jamais
    // pouvoir le relire (D4). Le cloisonnement de D2 était donc tenu en lecture
    // et ouvert en écriture, ce qui n'est un cloisonnement qu'à moitié.
    //
    // Le commanditaire a tranché : le gérant fait entrer la moto, la
    // supervision pose ce qu'elle a coûté. Une moto peut donc exister sans ce
    // document — et son absence est le signal que la supervision attend.
    // L'écrire à zéro dirait « acquise gratuitement » au lieu de « on ne sait
    // pas » (D82) ; rien ici ne l'exige, et le domaine ne le construit pas.
    match /motos/{motoId}/prive/{section} {
      allow read: if estResponsable();

      allow create, update: if section == 'cout'
                            && estResponsable()
                            && coutValide(request.resource.data)
                            && (!exists(/databases/$(database)/documents/motos/$(motoId))
                                || boutiqueDeLaMoto(motoId) == request.resource.data.boutiqueId);

      allow delete: if false;
    }

    // --- Clients (S6) -------------------------------------------------------
    // Le fichier clients est **commun à toutes les boutiques** (D16) : pas de
    // `boutiqueId`, donc pas de cloisonnement. C'est la seule collection dans
    // ce cas, et c'est un arbitrage assumé — un client est une personne, pas
    // une opération, et le retrouver d'une boutique à l'autre évite de le
    // ressaisir et de couper son historique en deux.
    //
    // Ce qu'un gérant voit ainsi : des noms et des numéros. Ce qu'il ne voit
    // toujours pas : les ventes, les montants et les dossiers des autres
    // boutiques, qui restent cloisonnés ailleurs dans ce fichier.

    function clientValide(donnees) {
      return donnees.keys().hasOnly(['nom', 'nomNormalise', 'telephone', 'telephoneNormalise',
                                     'telephone2', 'adresse', 'note'].concat(champsAudit()))
             && donnees.keys().hasAll(['nom', 'nomNormalise', 'telephone', 'telephoneNormalise',
                                       'telephone2', 'adresse', 'note'].concat(champsAudit()))
             && donnees.nom is string
             && donnees.nom.size() > 0
             && donnees.nom.size() <= 80
             && donnees.nomNormalise is string
             && donnees.nomNormalise.size() <= 80
             && donnees.telephone is string
             && donnees.telephone.size() > 0
             && donnees.telephone.size() <= 32
             && donnees.telephoneNormalise is string
             && donnees.telephoneNormalise.size() > 0
             && donnees.telephoneNormalise.size() <= 32
             && texteBorne(donnees.telephone2, 32)
             && texteBorne(donnees.adresse, 200)
             && texteBorne(donnees.note, 300);
    }

    match /clients/{clientId} {
      allow read: if connecte();

      allow create: if connecte()
                    && clientValide(request.resource.data)
                    && traceCreation(request.resource.data);

      allow update: if connecte()
                    && clientValide(request.resource.data)
                    && traceModification(request.resource.data, resource.data);

      // Un client est cité par des ventes : on le corrige, on ne l'efface pas.
      allow delete: if false;
    }

    // --- Ventes de motos (S8) ----------------------------------------------
    // Le document que le gérant lit pour travailler. Ce qu'il ne contient pas
    // compte autant : le coût figé et la marge vivent dans
    // `ventesMotos/{id}/prive/marge`, fermé en écriture à TOUT navigateur et
    // ouvert en lecture au seul responsable (D2, D51). Il est rempli par un
    // déclencheur via le SDK Admin, qui ne passe pas par ces règles — c'est ce
    // qui rend la marge infalsifiable et pas seulement invisible.
    //
    // Aucune mise à jour n'est permise ici. S8 crée, et c'est tout : les
    // agrégats de paiement s'ouvriront en S9, le cycle des documents en S11,
    // l'annulation en S25. Ouvrir d'avance ce qu'aucun écran n'utilise, c'est
    // ouvrir sans test (SECURITY.md §0).

    function numeroDOrigine(valeur) {
      // Jamais de suffixe à la création : un appareil n'émet que des numéros
      // d'origine, le `-B` est la réponse du serveur à une collision (D5).
      return valeur is string && valeur.matches('^[A-Z]{3}-[0-9]{4}-[0-9]{4,}$');
    }

    function listeBornee(valeur, maximum) {
      return valeur is list && valeur.size() <= maximum;
    }

    function dateAppareil(valeur) {
      // La date métier vient de l'appareil (D38). On ne peut pas vérifier une
      // date passée, mais on peut refuser l'absurde : une horloge en avance.
      return valeur is timestamp && valeur <= request.time + duration.value(1, 'd');
    }

    function venteValide(donnees) {
      return donnees.keys().hasOnly(['numero', 'numeroInitial', 'boutiqueId', 'motoId', 'clientId',
                                     'date', 'prixConvenu', 'modePaiement', 'inclus', 'nonInclus',
                                     'totalPaye', 'resteDu', 'statutPaiement', 'dernierVersementAt',
                                     'motoRemise', 'dateRemiseMoto', 'tokenSuivi',
                                     'lienSuiviEnvoyeAt', 'statutDossier',
                                     'dateClotureDossier'].concat(champsAudit()))
             && donnees.keys().hasAll(['numero', 'numeroInitial', 'boutiqueId', 'motoId', 'clientId',
                                       'date', 'prixConvenu', 'modePaiement', 'inclus', 'nonInclus',
                                       'totalPaye', 'resteDu', 'statutPaiement', 'dernierVersementAt',
                                       'motoRemise', 'dateRemiseMoto', 'tokenSuivi',
                                       'lienSuiviEnvoyeAt', 'statutDossier',
                                       'dateClotureDossier'].concat(champsAudit()))
             // Les deux numéros sont égaux à la création, et `numeroInitial` ne
             // bougera plus jamais : c'est la clé de rapprochement des doublons
             // (D44), et une clé qui bouge ne rapproche plus rien.
             && numeroDOrigine(donnees.numero)
             && donnees.numero == donnees.numeroInitial
             && donnees.boutiqueId is string
             && donnees.motoId is string
             && donnees.motoId.size() > 0
             && donnees.clientId is string
             && donnees.clientId.size() > 0
             && dateAppareil(donnees.date)
             && montantValide(donnees.prixConvenu)
             && donnees.prixConvenu > 0
             && donnees.modePaiement in ['comptant', 'credit', 'tranches']
             && listeBornee(donnees.inclus, 20)
             && listeBornee(donnees.nonInclus, 20)
             // L'arithmétique de la vente, vérifiée ici et pas seulement dans le
             // formulaire : c'est le seul endroit qu'un client modifié ne
             // contourne pas.
             && montantValide(donnees.totalPaye)
             && montantValide(donnees.resteDu)
             && donnees.totalPaye + donnees.resteDu == donnees.prixConvenu
             && donnees.statutPaiement == (donnees.resteDu == 0
                                           ? 'solde'
                                           : (donnees.totalPaye > 0 ? 'partiel' : 'impaye'))
             // Une vente au comptant est payée en entier, par définition (§6.2).
             && (donnees.modePaiement != 'comptant' || donnees.resteDu == 0)
             // Crédit et comptant livrent la moto ; les tranches la retiennent.
             && donnees.motoRemise is bool
             && donnees.motoRemise == (donnees.modePaiement != 'tranches')
             && (donnees.motoRemise ? dateAppareil(donnees.dateRemiseMoto)
                                    : donnees.dateRemiseMoto == null)
             && (donnees.totalPaye > 0 ? dateAppareil(donnees.dernierVersementAt)
                                       : donnees.dernierVersementAt == null)
             // 32 octets en base64url : le secret qui ouvre la page de suivi (D6).
             && donnees.tokenSuivi is string
             && donnees.tokenSuivi.size() == 43
             && donnees.tokenSuivi.matches('^[A-Za-z0-9_-]+$')
             && donnees.lienSuiviEnvoyeAt == null
             && donnees.statutDossier == 'ouvert'
             && donnees.dateClotureDossier == null;
    }

    function peutVendrePour(boutiqueId) {
      return estResponsable() || estGerantDe(boutiqueId);
    }

    // --- Versements et suivi des paiements (S9) ----------------------------
    // S8 avait fermé ce document en modification. S9 y perce une porte
    // étroite : deux gestes passent, et tout le reste demeure immuable. Le
    // numéro, le prix, le mode de paiement, le client, la moto et le token de
    // suivi ne bougeront jamais depuis un navigateur.
    //
    // Ce qui NE passe toujours pas : corriger ou annuler un versement. C'est
    // une opération sensible sur de l'argent déjà encaissé et un reçu déjà
    // remis ; elle reste à S25, avec son historique (D58).

    function seulsChangent(champs) {
      // Les horodatages d'audit accompagnent toute modification : ils font
      // partie du geste, pas de ce qu'on autorise en plus.
      return request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(champs.concat(['updatedAt', 'updatedBy', 'updatedByName']));
    }

    // Un encaissement. `totalPaye` ne peut que MONTER : un total qui baisse est
    // soit une erreur, soit une annulation — et l'annulation est journalisée,
    // réservée au responsable, et n'existe pas encore (S25).
    //
    // Le plafond `totalPaye <= prixConvenu` interdit le trop-perçu depuis un
    // navigateur. Le déclencheur serveur, lui, ne passe pas par ces règles :
    // s'il constate une somme supérieure — deux appareils hors ligne ayant
    // encaissé chacun de leur côté — il l'écrit, et cette vente n'accepte plus
    // aucun versement, ce qui est exactement ce qu'on veut.
    function encaissementValideSurVente(donnees, ancien) {
      return seulsChangent(['totalPaye', 'resteDu', 'statutPaiement', 'dernierVersementAt'])
             && montantValide(donnees.totalPaye)
             && montantValide(donnees.resteDu)
             && donnees.totalPaye > ancien.totalPaye
             && donnees.totalPaye <= donnees.prixConvenu
             && donnees.resteDu == donnees.prixConvenu - donnees.totalPaye
             && donnees.statutPaiement == (donnees.resteDu == 0
                                           ? 'solde'
                                           : (donnees.totalPaye > 0 ? 'partiel' : 'impaye'))
             && dateAppareil(donnees.dernierVersementAt);
    }

    // La remise de la moto au terme des tranches (§6.2) : le seul moment où
    // l'argent détenu pour le compte d'un client devient une recette.
    //
    // La condition tient à `resteDu == 0` sur l'état d'AVANT. Cet agrégat est
    // un cache d'affichage (D56), mais il ne peut se tromper que dans le bon
    // sens : `totalPaye` n'additionne que des versements réels, donc il reste
    // inférieur ou égal à la vérité, donc `resteDu` reste supérieur ou égal.
    // Un reste dû nul l'est donc vraiment.
    function remiseMotoValide(donnees, ancien) {
      return seulsChangent(['motoRemise', 'dateRemiseMoto'])
             && ancien.modePaiement == 'tranches'
             && ancien.motoRemise == false
             && ancien.resteDu == 0
             && donnees.motoRemise == true
             && dateAppareil(donnees.dateRemiseMoto);
    }

    match /ventesMotos/{venteId} {
      allow read: if peutVendrePour(resource.data.boutiqueId);

      allow create: if venteValide(request.resource.data)
                    && traceCreation(request.resource.data)
                    && peutVendrePour(request.resource.data.boutiqueId);

      allow update: if peutVendrePour(resource.data.boutiqueId)
                    && traceModification(request.resource.data, resource.data)
                    && (encaissementValideSurVente(request.resource.data, resource.data)
                        || remiseMotoValide(request.resource.data, resource.data));

      // Une vente ne se supprime pas : elle s'annule, et l'annulation laisse
      // une trace. S25.
      allow delete: if false;
    }

    // L'historique d'une vente (§3.5). Une seule entrée y est écrite
    // aujourd'hui — la remise de la moto — parce que c'est le seul changement
    // d'état dont la trace disparaîtrait autrement : `updatedBy` sur la vente
    // sera écrasé par la prochaine écriture. Un versement, lui, EST sa propre
    // trace.
    function historiqueValide(donnees, venteId) {
      return donnees.keys().hasOnly(['boutiqueId', 'venteId', 'evenement',
                                     'date'].concat(champsAudit()))
             && donnees.keys().hasAll(['boutiqueId', 'venteId', 'evenement',
                                       'date'].concat(champsAudit()))
             && donnees.boutiqueId is string
             && donnees.venteId == venteId
             && donnees.evenement == 'remise_moto'
             && dateAppareil(donnees.date);
    }

    match /ventesMotos/{venteId}/historique/{entree} {
      allow read: if peutVendrePour(resource.data.boutiqueId);
      allow create: if historiqueValide(request.resource.data, venteId)
                    && traceCreation(request.resource.data)
                    && peutVendrePour(request.resource.data.boutiqueId);
      // Un journal ne se réécrit pas. C'est ce qui en fait un journal.
      allow update, delete: if false;
    }

    // La marge : lecture réservée au responsable, écriture refusée à tout le
    // monde. Seul le déclencheur `figerMargeVente` la remplit, et il passe par
    // le SDK Admin — hors de portée de ces règles, donc hors de portée d'un
    // navigateur.
    match /ventesMotos/{venteId}/prive/{section} {
      allow read: if estResponsable();
      allow write: if false;
    }

    // Le dossier. Le `boutiqueId` y est répété pour deux raisons : dans un lot,
    // les règles évaluent chaque document contre l'état d'AVANT — la vente
    // parente n'existe donc pas encore quand son dossier est validé — et une
    // requête de groupe de collections ne peut filtrer que sur les champs du
    // document lui-même. Même montage qu'en S5 sur le coût d'une moto.
    //
    // Le type est l'identifiant du document : deux cartes grises dans un même
    // dossier sont structurellement impossibles, sans qu'aucune règle ait à le
    // dire.
    function documentDossierValide(donnees, venteId, type) {
      return donnees.keys().hasOnly(['boutiqueId', 'venteId', 'type', 'statut'].concat(champsAudit()))
             && donnees.keys().hasAll(['boutiqueId', 'venteId', 'type', 'statut'].concat(champsAudit()))
             && donnees.boutiqueId is string
             && donnees.venteId == venteId
             && donnees.type == type
             && type in ['quittance', 'cmc', 'carte_grise', 'plaque']
             // S8 ouvre le dossier ; c'est S11 qui fera vivre les autres statuts.
             && donnees.statut == 'a_faire';
    }

    // La machine a etats, cote serveur. Elle repete `lib/domain/dossier.ts`, et
    // cette repetition est voulue : le client decide de ce qu'il PROPOSE, la
    // base decide de ce qu'elle ACCEPTE (D27). Un appareil dont le code a ete
    // modifie ne doit pas pouvoir sauter le depot chez le prestataire, sinon la
    // liste des dossiers ne sait plus qui detient quoi (D65).
    function arriveDejaFait(type) {
      return type in ['quittance', 'cmc'];
    }

    function transitionDossierAutorisee(type, de, vers) {
      return de == 'a_faire'
               ? (vers == 'non_applicable'
                  || vers == (arriveDejaFait(type) ? 'revenu_magasin' : 'chez_prestataire'))
             : de == 'chez_prestataire'
               ? (!arriveDejaFait(type) && vers == 'revenu_magasin')
             : de == 'revenu_magasin'
               ? vers == 'remis_client'
             // 'remis_client' et 'non_applicable' ne ressortent jamais.
             : false;
    }

    // Les champs du depot et de la remise n'existent pas a la creation : S8
    // ouvre quatre documents nus. Ils apparaissent au fil du cycle, d'ou un
    // `hasOnly` plus large que le `hasAll`, qui n'exige que le socle.
    function champsDossier() {
      return ['boutiqueId', 'venteId', 'type', 'statut'];
    }

    function champsDepot() {
      // Pas de champ de fichier ici : la quittance et le CMC s'envoient avec la
      // moto, a l'entree en stock, et non sur la ligne du dossier.
      return ['prestataireId', 'prestataireNom', 'deposeLe', 'avance', 'disponibleLe', 'remisLe'];
    }

    function depotRenseigne(donnees) {
      return donnees.keys().hasAll(['prestataireId', 'prestataireNom', 'deposeLe', 'avance'])
             && donnees.prestataireId is string
             && donnees.prestataireId.size() > 0
             && texteBorne(donnees.prestataireNom, 80)
             && dateAppareil(donnees.deposeLe)
             // Strictement positive. Une avance a zero n'est pas une avance :
             // c'est un travail confie a credit, et le credit se modelise
             // ailleurs. Les confondre ferait apparaitre des depots sans
             // contrepartie en caisse, que rien ne viendrait solder.
             // Corollaire : l'encaissement de sortie est inconditionnel.
             && montantValide(donnees.avance)
             && donnees.avance > 0;
    }

    function documentDossierMaj(ancien, nouveau, venteId, type) {
      return nouveau.keys().hasOnly(champsDossier().concat(champsDepot()).concat(champsAudit()))
             && nouveau.keys().hasAll(champsDossier().concat(champsAudit()))
             // Ce qui identifie le document ne bouge jamais.
             && nouveau.boutiqueId == ancien.boutiqueId
             && nouveau.venteId == venteId
             && nouveau.type == type
             && transitionDossierAutorisee(type, ancien.statut, nouveau.statut)
             && (nouveau.statut != 'chez_prestataire' || depotRenseigne(nouveau))
             && (nouveau.statut != 'remis_client'
                 || (nouveau.keys().hasAll(['remisLe']) && dateAppareil(nouveau.remisLe)));
    }

    match /ventesMotos/{venteId}/documents/{type} {
      allow read: if peutVendrePour(resource.data.boutiqueId);
      allow create: if documentDossierValide(request.resource.data, venteId, type)
                    && traceCreation(request.resource.data)
                    && peutVendrePour(request.resource.data.boutiqueId);
      allow update: if documentDossierMaj(resource.data, request.resource.data, venteId, type)
                    && traceModification(request.resource.data, resource.data)
                    && peutVendrePour(resource.data.boutiqueId);
      // Un document de dossier ne se supprime pas : `non_applicable` est la
      // maniere de l'ecarter, et elle laisse une trace.
      allow delete: if false;
    }

    // L'historique de chaque changement de statut (`prompt.md` §3.5). Il
    // s'ecrit, il ne se reecrit pas : c'est ce qui en fait un historique.
    match /ventesMotos/{venteId}/documents/{type}/historique/{entree} {
      allow read: if peutVendrePour(resource.data.boutiqueId);
      allow create: if request.resource.data.keys().hasOnly(
                         ['boutiqueId', 'venteId', 'type', 'de', 'vers', 'le']
                         .concat(champsAudit()))
                    && request.resource.data.keys().hasAll(
                         ['boutiqueId', 'venteId', 'type', 'de', 'vers', 'le']
                         .concat(champsAudit()))
                    && request.resource.data.venteId == venteId
                    && request.resource.data.type == type
                    && request.resource.data.de is string
                    && request.resource.data.vers is string
                    && dateAppareil(request.resource.data.le)
                    && traceCreation(request.resource.data)
                    && peutVendrePour(request.resource.data.boutiqueId);
      allow update, delete: if false;
    }

    // La lecture d'ensemble des dossiers, sur laquelle repose la liste des
    // ventes (§6.4). Une requête de groupe de collections n'emprunte PAS la
    // règle du chemin complet ci-dessus : il lui faut un chemin récursif, sinon
    // elle est refusée quoi qu'on autorise plus haut. La condition reste la
    // même — chacun ne lit que sa boutique.
    match /{chemin=**}/documents/{type} {
      allow read: if peutVendrePour(resource.data.boutiqueId);
    }

    // Les versements. S8 écrit celui du jour de la vente dans le lot de la
    // vente ; S9 ajoute les suivants. Aucun ne se modifie ni ne se supprime,
    // pour personne : un reçu remis à un client ne se retouche pas depuis un
    // écran. La correction et l'annulation sont à S25, journalisées.
    //
    // Le numéro du reçu dérive de celui de la vente, suivi du rang du versement
    // (D57) : `PTG-2608-0042/V2`. Ce n'est pas une seconde série de compteurs,
    // et c'est délibéré — un compteur nourri ailleurs que dans `ventesMotos`
    // serait invisible à un appareil neuf, qui refabriquerait les doublons que
    // le mécanisme existe pour éviter. Le suffixe `-B` d'une vente renumérotée
    // est admis : le reçu suit sa vente.
    function numeroRecu(valeur) {
      return valeur is string
             && valeur.matches('^[A-Z]{3}-[0-9]{4}-[0-9]{4,}(-[A-Z]+)?(/V[0-9]{1,4})?$');
    }

    function versementValide(donnees, venteId) {
      return donnees.keys().hasOnly(['boutiqueId', 'venteId', 'numeroRecu', 'date', 'montant',
                                     'moyenPaiement', 'reference',
                                     'encaissementId'].concat(champsAudit()))
             && donnees.keys().hasAll(['boutiqueId', 'venteId', 'numeroRecu', 'date', 'montant',
                                       'moyenPaiement', 'reference',
                                       'encaissementId'].concat(champsAudit()))
             && donnees.boutiqueId is string
             && donnees.venteId == venteId
             && numeroRecu(donnees.numeroRecu)
             && dateAppareil(donnees.date)
             && montantValide(donnees.montant)
             && donnees.montant > 0
             && donnees.moyenPaiement in ['especes', 'orange_money', 'moov_money', 'wave']
             && texteBorne(donnees.reference, 60)
             && donnees.encaissementId is string
             && donnees.encaissementId.size() > 0;
    }

    match /ventesMotos/{venteId}/versements/{versementId} {
      allow read: if peutVendrePour(resource.data.boutiqueId);
      allow create: if versementValide(request.resource.data, venteId)
                    && traceCreation(request.resource.data)
                    && peutVendrePour(request.resource.data.boutiqueId);
      allow update, delete: if false;
    }

    // La lecture d'ensemble des versements, sur laquelle reposent les trois
    // listes de suivi (§6.3) : elles additionnent les versements, jamais les
    // agrégats portés par les ventes (§3.4, D56). Comme pour les dossiers, une
    // requête de groupe de collections n'emprunte pas la règle du chemin
    // complet ci-dessus — il lui faut ce chemin récursif, à condition égale.
    match /{chemin=**}/versements/{versementId} {
      allow read: if peutVendrePour(resource.data.boutiqueId);
    }

    // La caisse. Rien ne lit encore ces documents — le journal et la clôture
    // sont post-MVP (S22) — mais l'argent qui entre aujourd'hui se trace
    // aujourd'hui : un journal comptable troué se répare par une migration, ce
    // qui coûte bien plus cher que ces quelques lignes (D53).
    function encaissementValide(donnees) {
      return donnees.keys().hasOnly(['boutiqueId', 'date', 'sens', 'montant', 'moyenPaiement',
                                     'origine', 'origineRefId', 'libelle',
                                     'categorieTranches'].concat(champsAudit()))
             && donnees.keys().hasAll(['boutiqueId', 'date', 'sens', 'montant', 'moyenPaiement',
                                       'origine', 'origineRefId', 'libelle',
                                       'categorieTranches'].concat(champsAudit()))
             && donnees.boutiqueId is string
             && dateAppareil(donnees.date)
             && donnees.sens in ['entree', 'sortie']
             && montantValide(donnees.montant)
             && donnees.montant > 0
             && donnees.moyenPaiement in ['especes', 'orange_money', 'moov_money', 'wave']
             && donnees.origine in ['vente_moto', 'versement', 'vente_piece', 'depense',
                                    'avance_prestataire', 'autre']
             && donnees.origineRefId is string
             && texteBorne(donnees.libelle, 120)
             // L'argent des tranches est un engagement, pas une recette, tant
             // que la moto dort au magasin (§6.2). Le drapeau se pose à
             // l'encaissement ; le retrouver après coup serait un cauchemar.
             && donnees.categorieTranches is bool;
    }

    match /encaissements/{encaissementId} {
      allow read: if peutVendrePour(resource.data.boutiqueId);
      allow create: if encaissementValide(request.resource.data)
                    && traceCreation(request.resource.data)
                    && peutVendrePour(request.resource.data.boutiqueId);
      // Une écriture de caisse ne se retouche pas : on la contre-passe. S22.
      allow update, delete: if false;
    }

    // --- La clôture de journée (S22) --------------------------------------
    // Une clôture est une **affirmation datée** : quelqu'un a compté le tiroir
    // ce soir-là et a déclaré ce qu'il y avait dedans. C'est ce qui la rend
    // immuable — un brouillon qu'on retouche n'affirme rien, et l'écart qu'on
    // peut corriger le lendemain cesse d'être une mesure.
    //
    // Trois invariants ne tiennent qu'ici, parce qu'un formulaire ne protège
    // rien et qu'un navigateur modifié contourne un formulaire :
    //
    // 1. **L'écart est calculé, jamais déclaré.** Il vaut exactement
    //    `comptées − attendues`. Le laisser libre permettrait d'annoncer un
    //    tiroir juste avec un comptage qui ne l'est pas.
    // 2. **Compter et clôturer volontairement sont la même chose.** Une
    //    clôture `gerant` porte un comptage ; une clôture `automatique` n'en
    //    porte aucun, et son écart est `null` et non zéro. C'est la réponse 4
    //    du commanditaire tenue honnête : une journée fermée seule n'a pas un
    //    écart nul, elle n'a pas d'écart. Un zéro s'additionnerait sur un mois
    //    et dirait « tout allait bien ».
    // 3. **L'identifiant dit la boutique et le jour.** `PTG_2026-09-05` n'est
    //    pas une convention de nommage mais une contrainte d'unicité : deux
    //    clôtures du même jour dans la même boutique sont structurellement
    //    impossibles, et deux appareils qui clôturent hors ligne entrent en
    //    collision — ce qui est le comportement voulu (D30).
    //
    // Le gérant clôture, et lui seul : c'est lui qui tient le tiroir, et un
    // geste de fin de journée qui attend quelqu'un d'autre n'est pas fait le
    // soir même. Le responsable lit sans écrire — arbitrage du commanditaire,
    // question 3 de `specs/S22-caisse.md`.

    function jourValide(valeur) {
      return valeur is string && valeur.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function clotureValide(donnees, clotureId) {
      return donnees.keys().hasOnly(['boutiqueId', 'jour', 'fondsOuverture', 'especesAttendues',
                                     'especesComptees', 'ecart', 'motif', 'cloturePar',
                                     'clotureLe', 'clotureParNom'].concat(champsAudit()))
             && donnees.keys().hasAll(['boutiqueId', 'jour', 'fondsOuverture', 'especesAttendues',
                                       'especesComptees', 'ecart', 'motif', 'cloturePar',
                                       'clotureLe', 'clotureParNom'].concat(champsAudit()))
             && donnees.boutiqueId is string
             && jourValide(donnees.jour)
             // L'identifiant n'est pas libre : il est la boutique et le jour.
             && clotureId == donnees.boutiqueId + '_' + donnees.jour
             && montantValide(donnees.fondsOuverture)
             && montantValide(donnees.especesAttendues)
             && donnees.cloturePar in ['gerant', 'automatique']
             // Compter et clôturer volontairement sont la même chose.
             && (donnees.cloturePar == 'gerant'
                   ? (montantValide(donnees.especesComptees)
                      && donnees.ecart is int
                      && donnees.ecart == donnees.especesComptees - donnees.especesAttendues)
                   : (donnees.especesComptees == null && donnees.ecart == null))
             && texteBorne(donnees.motif, 300)
             && dateAppareil(donnees.clotureLe)
             && texteBorne(donnees.clotureParNom, 200);
    }

    match /cloturesCaisse/{clotureId} {
      allow read: if peutVendrePour(resource.data.boutiqueId);
      allow create: if clotureValide(request.resource.data, clotureId)
                    && traceCreation(request.resource.data)
                    && estGerantDe(request.resource.data.boutiqueId);
      // Une affirmation ne se retouche pas. Corriger une journée close, si le
      // besoin apparaît, sera une contre-passation tracée — pas une réécriture.
      allow update, delete: if false;
    }

    // --- Pièces détachées (S20) ---------------------------------------------
    //
    // **Il n'y a pas de collection `stockPieces` dans ce produit**, et c'est
    // l'arbitrage structurant du lot. `prompt.md` §5.7 en décrit une, avec sa
    // `quantite` entretenue par déclencheur ; D61 l'écarte et le hors-ligne
    // tranche presque seul — un agrégat entretenu ne bouge pas quand le
    // déclencheur ne tourne pas, donc l'écran afficherait l'ancienne quantité
    // au comptoir précisément quand le réseau manque. La quantité se compte
    // depuis les mouvements, à la lecture.
    //
    // Conséquence directe sur ces règles : **« pas de stock négatif » ne peut
    // pas se tenir ici.** Une règle ne sait pas additionner une collection, et
    // une transaction ne fonctionne pas hors ligne. La garde vit donc à
    // l'écran, où le geste se fait (`lib/domain/piece.ts`), et ces règles ne
    // prétendent pas la tenir.

    function pieceValide(donnees) {
      return donnees.keys().hasOnly(['reference', 'designation', 'categorie', 'prixVente',
                                     'seuilAlerte', 'actif'].concat(champsAudit()))
             && donnees.keys().hasAll(['reference', 'designation', 'categorie', 'prixVente',
                                       'seuilAlerte', 'actif'].concat(champsAudit()))
             && donnees.reference is string
             && donnees.reference.size() > 0
             && donnees.reference.size() <= 40
             && donnees.designation is string
             && donnees.designation.size() > 0
             && donnees.designation.size() <= 120
             // Un mot, pas une clé : le commanditaire veut déclarer comme il
             // veut, et aucun écran de paramétrage ne tient cette liste (D90).
             && texteBorne(donnees.categorie, 60)
             // Nul tant que le responsable ne l'a pas posé : une référence
             // arrive parfois avant qu'on ait décidé de son prix. Elle existe
             // alors au catalogue et ne se vend pas (S21).
             && (donnees.prixVente == null || montantValide(donnees.prixVente))
             && donnees.seuilAlerte is int
             && donnees.seuilAlerte >= 0
             && donnees.seuilAlerte <= 1000000
             && donnees.actif is bool
             // **Aucun prix d'achat sur le document public.** Firestore ne sait
             // pas masquer un champ : un `prixAchat` posé ici serait lisible
             // par quiconque lit la pièce, c'est-à-dire par tout gérant (D2).
             && !donnees.keys().hasAny(['prixAchat']);
    }

    // Le catalogue appartient au responsable : une référence porte un prix, et
    // les prix appartiennent à la supervision. C'est la réponse 4 de S20, et
    // elle se sépare volontairement de celle des marques — une marque est un
    // mot du vocabulaire, une référence est un article avec un prix.
    match /pieces/{pieceId} {
      allow read: if connecte();
      allow create: if estResponsable()
                    && pieceValide(request.resource.data)
                    && traceCreation(request.resource.data);
      allow update: if estResponsable()
                    && pieceValide(request.resource.data)
                    && traceModification(request.resource.data, resource.data);
      // Rien ne se supprime : des mouvements citent leur pièce. On la
      // désactive, et elle reste lisible partout où elle a déjà servi.
      allow delete: if false;
    }

    // Le prix d'achat d'une référence, cloisonné comme celui d'une moto (D2),
    // et fermé au gérant dans les deux sens dès le premier jour — S39 a montré
    // ce que coûte un cloisonnement tenu d'un seul côté (D89).
    function coutPieceValide(donnees) {
      return donnees.keys().hasOnly(['prixAchat', 'updatedAt', 'updatedBy', 'updatedByName'])
             && donnees.keys().hasAll(['prixAchat', 'updatedAt', 'updatedBy', 'updatedByName'])
             && montantValide(donnees.prixAchat)
             && donnees.updatedAt == request.time
             && donnees.updatedBy == request.auth.uid
             && texteBorne(donnees.updatedByName, 200);
    }

    match /pieces/{pieceId}/prive/{section} {
      allow read: if estResponsable();
      allow create, update: if section == 'cout'
                            && estResponsable()
                            && coutPieceValide(request.resource.data);
      allow delete: if false;
    }

    // Les mouvements. La quantité est **toujours positive** : le sens vient du
    // type. Une quantité négative écrite à la main est une faute de frappe qui
    // ne se voit pas ; un type inconnu, lui, se refuse ici.
    //
    // `sortie_vente` reste admis alors que S21 n'existe pas encore : l'ajouter
    // après coup demanderait de rouvrir ce fichier pour une vente, et le
    // domaine refuse déjà de le saisir à la main.
    function mouvementPieceValide(donnees) {
      return donnees.keys().hasOnly(['boutiqueId', 'pieceId', 'type', 'quantite', 'note',
                                     'date'].concat(champsAudit()))
             && donnees.keys().hasAll(['boutiqueId', 'pieceId', 'type', 'quantite', 'note',
                                       'date'].concat(champsAudit()))
             && donnees.boutiqueId is string
             && donnees.pieceId is string
             && donnees.type in ['entree', 'sortie_vente', 'sortie_autre',
                                 'transfert_entree', 'transfert_sortie', 'ajustement_inventaire']
             && donnees.quantite is int
             && donnees.quantite > 0
             && donnees.quantite <= 1000000
             && texteBorne(donnees.note, 120)
             // La date vient de l'appareil (D38) : un mouvement saisi lundi
             // sans réseau et synchronisé mercredi a eu lieu lundi. On la borne
             // seulement contre une horloge déréglée.
             && donnees.date is timestamp
             && donnees.date <= request.time + duration.value(1, 'd')
             && exists(/databases/$(database)/documents/pieces/$(donnees.pieceId));
    }

    match /mouvementsPieces/{mouvementId} {
      allow read: if estResponsable() || estGerantDe(resource.data.boutiqueId);

      allow create: if mouvementPieceValide(request.resource.data)
                    && traceCreation(request.resource.data)
                    && (estResponsable() || estGerantDe(request.resource.data.boutiqueId));

      // **Un mouvement est un fait, pas un état.** Le corriger reviendrait à
      // réécrire l'histoire du stock, et la quantité étant la somme des
      // mouvements, une retouche silencieuse déplacerait un total sans laisser
      // de trace. On corrige par un mouvement inverse, qui se voit.
      allow update, delete: if false;
    }

    // --- La vente de pièces au comptoir (S21) ------------------------------
    // Une vente de pièces est une **pièce comptable**, au même titre qu'une
    // vente de moto : elle porte un numéro qu'on dicte au téléphone, et elle ne
    // se retouche pas. Ce que la règle peut tenir, elle le tient ; ce qu'elle ne
    // peut pas tenir est nommé plus bas.
    function ligneVenteValide(ligne) {
      return ligne.keys().hasOnly(['pieceId', 'reference', 'designation', 'quantite',
                                   'prixUnitaire', 'total'])
             && ligne.keys().hasAll(['pieceId', 'reference', 'designation', 'quantite',
                                     'prixUnitaire', 'total'])
             && ligne.pieceId is string
             && texteBorne(ligne.reference, 40)
             && texteBorne(ligne.designation, 120)
             && ligne.quantite is int
             && ligne.quantite > 0
             && ligne.quantite <= 1000000
             && ligne.prixUnitaire is int
             && ligne.prixUnitaire > 0
             && ligne.prixUnitaire <= 1000000000
             // Le total de la ligne est **calculé**, pas déclaré : un document
             // dont les nombres ne s'accordent pas entre eux est un document
             // qu'on ne peut plus relire avec confiance six mois plus tard.
             && ligne.total == ligne.quantite * ligne.prixUnitaire;
    }

    // **Ce qu'on peut tenir sur les vingt lignes — et ce qui a été mesuré.**
    //
    // Le langage des règles n'a pas de repli sur une liste : vérifier vingt
    // lignes demande de les écrire vingt fois. Et `||` n'y court-circuite pas
    // comme on l'espère — CEL évalue ses deux membres —, si bien qu'un
    // `size() <= index || ligneVenteValide(lignes[index])` déplié coûte ses
    // vingt validations complètes même pour une vente d'une seule ligne.
    //
    // Mesuré sur l'émulateur (`regles/vente-pieces.test.ts`, dernier test du
    // groupe) : le plafond de **1000 expressions par requête** tombe dès la
    // sixième ligne ainsi dépliée, et dès la dixième même en ne gardant que les
    // nombres. Vingt lignes intégralement vérifiées n'est donc pas une question
    // de patience : la plateforme ne le permet pas.
    //
    // Ce qui tient, en revanche : le **total de chaque ligne** — entier,
    // strictement positif — et le **total du document égal à leur somme**.
    // C'est ce qui porte l'argent. Une ligne ne peut plus gonfler la recette
    // sans que l'en-tête le dise, ni se compenser avec une ligne négative, et
    // la caisse ne peut plus recevoir un montant que le détail contredit. Ce
    // qui reste hors de portée est nommé plus bas.
    //
    // **Les deux contrôles n'en font qu'un, et c'est une contrainte de budget.**
    // Un second passage de vingt termes pour la positivité franchissait le
    // plafond ; un appel de fonction par terme aussi. Restent vingt termes en
    // ligne, où une ligne malsaine — total absent, non entier, nul ou négatif —
    // n'est pas rejetée sur place mais **empoisonne la somme** avec deux
    // milliards.
    //
    // Ce que cela vaut, précisément : `montantValide` borne `donnees.total` à un
    // milliard, chaque terme sain est nul ou strictement positif, donc une
    // seule ligne empoisonnée porte la somme au-delà de deux milliards et
    // l'égalité devient impossible à satisfaire. Un dépassement d'entier n'est
    // pas une échappatoire non plus : CEL en fait une erreur, et une erreur
    // refuse l'écriture.
    function sommeDesLignes(lignes) {
      return (lignes.size() <= 0 ? 0 : (lignes[0].total is int && lignes[0].total > 0 ? lignes[0].total : 2000000000))
             + (lignes.size() <= 1 ? 0 : (lignes[1].total is int && lignes[1].total > 0 ? lignes[1].total : 2000000000))
             + (lignes.size() <= 2 ? 0 : (lignes[2].total is int && lignes[2].total > 0 ? lignes[2].total : 2000000000))
             + (lignes.size() <= 3 ? 0 : (lignes[3].total is int && lignes[3].total > 0 ? lignes[3].total : 2000000000))
             + (lignes.size() <= 4 ? 0 : (lignes[4].total is int && lignes[4].total > 0 ? lignes[4].total : 2000000000))
             + (lignes.size() <= 5 ? 0 : (lignes[5].total is int && lignes[5].total > 0 ? lignes[5].total : 2000000000))
             + (lignes.size() <= 6 ? 0 : (lignes[6].total is int && lignes[6].total > 0 ? lignes[6].total : 2000000000))
             + (lignes.size() <= 7 ? 0 : (lignes[7].total is int && lignes[7].total > 0 ? lignes[7].total : 2000000000))
             + (lignes.size() <= 8 ? 0 : (lignes[8].total is int && lignes[8].total > 0 ? lignes[8].total : 2000000000))
             + (lignes.size() <= 9 ? 0 : (lignes[9].total is int && lignes[9].total > 0 ? lignes[9].total : 2000000000))
             + (lignes.size() <= 10 ? 0 : (lignes[10].total is int && lignes[10].total > 0 ? lignes[10].total : 2000000000))
             + (lignes.size() <= 11 ? 0 : (lignes[11].total is int && lignes[11].total > 0 ? lignes[11].total : 2000000000))
             + (lignes.size() <= 12 ? 0 : (lignes[12].total is int && lignes[12].total > 0 ? lignes[12].total : 2000000000))
             + (lignes.size() <= 13 ? 0 : (lignes[13].total is int && lignes[13].total > 0 ? lignes[13].total : 2000000000))
             + (lignes.size() <= 14 ? 0 : (lignes[14].total is int && lignes[14].total > 0 ? lignes[14].total : 2000000000))
             + (lignes.size() <= 15 ? 0 : (lignes[15].total is int && lignes[15].total > 0 ? lignes[15].total : 2000000000))
             + (lignes.size() <= 16 ? 0 : (lignes[16].total is int && lignes[16].total > 0 ? lignes[16].total : 2000000000))
             + (lignes.size() <= 17 ? 0 : (lignes[17].total is int && lignes[17].total > 0 ? lignes[17].total : 2000000000))
             + (lignes.size() <= 18 ? 0 : (lignes[18].total is int && lignes[18].total > 0 ? lignes[18].total : 2000000000))
             + (lignes.size() <= 19 ? 0 : (lignes[19].total is int && lignes[19].total > 0 ? lignes[19].total : 2000000000));
    }

    function ventePieceValide(donnees) {
      return donnees.keys().hasOnly(['numero', 'numeroInitial', 'boutiqueId', 'date', 'clientId',
                                     'lignes', 'total', 'moyenPaiement'].concat(champsAudit()))
             && donnees.keys().hasAll(['numero', 'numeroInitial', 'boutiqueId', 'date', 'clientId',
                                       'lignes', 'total', 'moyenPaiement'].concat(champsAudit()))
             // Les deux numéros sont égaux à la création, et `numeroInitial` ne
             // bougera plus : c'est la clé de rapprochement des doublons que la
             // réconciliation serveur suffixe (D5). Même contrat qu'une vente de
             // moto, parce que Q1 a tranché un compteur **partagé** entre les
             // deux collections — un numéro dicté désigne une seule pièce.
             && numeroDOrigine(donnees.numero)
             && donnees.numeroInitial == donnees.numero
             && donnees.boutiqueId is string
             && dateAppareil(donnees.date)
             // Le client est facultatif au comptoir (§9) : la chaîne vide dit
             // « quelqu'un qui passe », et c'est le cas courant.
             && donnees.clientId is string
             && donnees.lignes is list
             && donnees.lignes.size() > 0
             && donnees.lignes.size() <= 20
             // La première ligne intégralement — c'est tout ce que le plafond
             // d'expressions autorise. Les vingt totaux, eux, sont tenus par
             // l'égalité qui suit : `montantValide` la borne, et la somme
             // refuse toute ligne dont le total n'est pas un entier positif.
             && ligneVenteValide(donnees.lignes[0])
             && montantValide(donnees.total)
             && donnees.total > 0
             && donnees.total == sommeDesLignes(donnees.lignes)
             && donnees.moyenPaiement in ['especes', 'orange_money', 'moov_money', 'wave'];
    }

    match /ventesPieces/{venteId} {
      allow read: if peutVendrePour(resource.data.boutiqueId);

      allow create: if ventePieceValide(request.resource.data)
                    && traceCreation(request.resource.data)
                    && peutVendrePour(request.resource.data.boutiqueId);

      // **Une vente enregistrée ne se retouche pas, elle se contre-passe.**
      // Même principe qu'un versement et qu'une écriture de caisse : le stock
      // est descendu, la recette est au journal, et un document modifiable
      // rendrait les trois incohérents sans laisser de trace.
      allow update, delete: if false;
    }

    // **Ce que ces règles ne peuvent pas tenir, et il faut le dire.**
    //
    // *Le détail des lignes au-delà de la première.* Leur quantité, leur prix
    // unitaire, leur référence et leur jeu de clés ne sont pas vérifiés : le
    // plafond d'expressions tombe avant. Ce qui l'est, et qui borne les dégâts,
    // c'est leur total — positif — et la somme qui doit tomber juste. Une
    // deuxième ligne peut donc annoncer une quantité absurde en face d'un total
    // exact ; elle ne peut plus faire mentir la recette. Le reste est tenu par
    // `validerPanier` et `figerLignes`, c'est-à-dire par le geste, et par rien
    // d'autre côté base.
    //
    // *Le lien vers les mouvements de stock.* Une vente doit produire un
    // `sortie_vente` par ligne et un encaissement ; c'est le **batch** qui le
    // tient, parce qu'une règle ne voit qu'un document à la fois. Rien ici ne
    // le vérifie — et, à ce jour, **aucun test non plus** : le test bout en
    // bout qui le prouverait est le critère resté ouvert de
    // `specs/S21-vente-pieces.md`. Tant qu'il n'existe pas, l'invariant tient
    // sur la relecture de `enregistrerVentePiece`, et sur rien d'autre. Le dire
    // ici est le minimum : une protection annoncée mais absente est pire que
    // pas de protection, parce qu'on cesse de la chercher.
    //
    // *Le stock disponible.* Une règle ne sait pas additionner une collection,
    // et une transaction ne fonctionne pas hors ligne. « Pas de négatif » est
    // donc une règle du **geste** (D94), tenue là où le geste se fait.

    // --- Écritures de vérification de la synchronisation -------------------
    // Produites par l'écran /diagnostic. Sans valeur métier, jamais lues par
    // l'application, et réservées à une session ouverte.
    match /diagnostics/{essai} {
      allow read: if false;
      allow create: if connecte()
                    && request.resource.data.keys().hasOnly(['ecritA', 'origine'])
                    && request.resource.data.origine == 'diagnostic';
      allow update, delete: if false;
    }

    // Tout le reste est fermé tant qu'une spec ne l'ouvre pas explicitement.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
