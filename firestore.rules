rules_version = '2';

/*
  Règles Firestore.

  Principe non négociable, posé dès la première ligne : refus par défaut, et
  aucun accès direct pour un utilisateur non authentifié (SECURITY.md §1 et §4,
  prompt.md §16). Les pages publiques client et prestataire ne feront jamais
  d'exception ici : elles passeront par l'Admin SDK côté serveur.

  Chaque spec ajoute ses propres règles avec ses tests. S12 est la passe de
  durcissement d'ensemble — pas le moment où l'on commence à écrire ce fichier.
*/

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Fonctions d'aide -------------------------------------------------
    // Le rôle est lu dans le custom claim, jamais dans un document : un rôle
    // stocké dans une collection modifiable serait un rôle qu'on peut se
    // donner soi-même.

    function connecte() {
      return request.auth != null;
    }

    function role() {
      return request.auth.token.role;
    }

    function estResponsable() {
      return connecte() && role() == 'responsable';
    }

    // --- Comptes utilisateurs (S2) ---------------------------------------
    // `users/{uid}` est un **miroir** lisible du compte, pas la source des
    // droits. Personne ne l'écrit depuis un navigateur : seules les Cloud
    // Functions y touchent, via le SDK Admin qui ne passe pas par ces règles.
    // C'est ce qui rend structurellement impossible de se promouvoir
    // responsable ou de se rattacher à une autre boutique.
    match /users/{uid} {
      allow read: if estResponsable() || (connecte() && request.auth.uid == uid);
      allow create, update, delete: if false;
    }

    // --- Boutiques (S3) ---------------------------------------------------
    // L'identifiant du document EST le code de la boutique. Firestore ne sait
    // pas imposer l'unicité d'un champ ; en faire la clé la donne gratuitement,
    // et le code entre dans les numéros de reçus (D5) donc il ne bouge jamais.
    //
    // Le gérant ne lit que la sienne : c'est la seule dont il ait besoin, et en
    // cas de doute on expose le moins (SECURITY.md §0, cf. D7).

    function texteBorne(valeur, maximum) {
      return valeur is string && valeur.size() <= maximum;
    }

    function boutiqueValide(donnees, code) {
      return donnees.keys().hasOnly(['nom', 'code', 'adresse', 'telephone', 'actif',
                                     'createdAt', 'createdBy', 'createdByName',
                                     'updatedAt', 'updatedBy', 'updatedByName'])
             && donnees.keys().hasAll(['nom', 'code', 'adresse', 'telephone', 'actif',
                                       'createdAt', 'createdBy', 'createdByName',
                                       'updatedAt', 'updatedBy', 'updatedByName'])
             && donnees.code == code
             && donnees.code.matches('^[A-Z]{3}$')
             && donnees.nom is string
             && donnees.nom.size() > 0
             && donnees.nom.size() <= 80
             && texteBorne(donnees.adresse, 200)
             && texteBorne(donnees.telephone, 40)
             && texteBorne(donnees.createdByName, 200)
             && texteBorne(donnees.updatedByName, 200)
             && donnees.actif is bool
             && donnees.createdBy is string
             && donnees.updatedBy is string;
    }

    match /boutiques/{code} {
      allow read: if estResponsable()
                  || (connecte() && request.auth.token.boutiqueId == code);

      allow create: if estResponsable()
                    && boutiqueValide(request.resource.data, code)
                    && request.resource.data.createdAt == request.time
                    && request.resource.data.updatedAt == request.time
                    && request.resource.data.createdBy == request.auth.uid;

      // Le code et la date de création ne bougent pas. C'est aussi ce qui
      // empêche une « création » de recouvrir une boutique existante : le
      // formulaire enverrait un createdAt neuf, refusé ici.
      allow update: if estResponsable()
                    && boutiqueValide(request.resource.data, code)
                    && request.resource.data.code == resource.data.code
                    && request.resource.data.createdAt == resource.data.createdAt
                    && request.resource.data.createdBy == resource.data.createdBy
                    && request.resource.data.updatedAt == request.time
                    && request.resource.data.updatedBy == request.auth.uid;

      // Une boutique ne se supprime pas : des ventes et des numéros de reçus
      // portent son code. On la ferme, elle reste lisible.
      allow delete: if false;
    }

    // --- Référentiels et entreprise (S4) -----------------------------------
    // Tout le monde lit, seul le responsable écrit. Le gérant a besoin de ces
    // listes pour saisir une moto ou déposer un dossier, et des coordonnées de
    // l'entreprise pour imprimer un reçu — y compris hors ligne, d'où le fait
    // que le logo voyage dans le document plutôt que dans Storage (D35).
    //
    // Rien ne se supprime : une marque, une provenance, un prestataire sont
    // cités par des motos et des dossiers. On les désactive.

    function traceCreation(donnees) {
      return donnees.createdAt == request.time
             && donnees.updatedAt == request.time
             && donnees.createdBy == request.auth.uid
             && donnees.updatedBy == request.auth.uid
             && texteBorne(donnees.createdByName, 200)
             && texteBorne(donnees.updatedByName, 200);
    }

    function traceModification(donnees, ancien) {
      return donnees.updatedAt == request.time
             && donnees.updatedBy == request.auth.uid
             && texteBorne(donnees.updatedByName, 200)
             && donnees.createdAt == ancien.createdAt
             && donnees.createdBy == ancien.createdBy;
    }

    function champsAudit() {
      return ['createdAt', 'createdBy', 'createdByName', 'updatedAt', 'updatedBy', 'updatedByName'];
    }

    function nomBorne(valeur) {
      return valeur is string && valeur.size() > 0 && valeur.size() <= 60;
    }

    function referentielValide(donnees) {
      return donnees.keys().hasOnly(['nom', 'actif'].concat(champsAudit()))
             && donnees.keys().hasAll(['nom', 'actif'].concat(champsAudit()))
             && nomBorne(donnees.nom)
             && donnees.actif is bool;
    }

    // Les trois référentiels de même forme : un nom, un état. La liste est
    // explicite — ce n'est pas un joker sur les collections inconnues.
    match /{referentiel}/{id} {
      allow read: if connecte()
                  && referentiel in ['marques', 'provenances', 'typesFrais'];
      allow create: if estResponsable()
                    && referentiel in ['marques', 'provenances', 'typesFrais']
                    && referentielValide(request.resource.data)
                    && traceCreation(request.resource.data);
      allow update: if estResponsable()
                    && referentiel in ['marques', 'provenances', 'typesFrais']
                    && referentielValide(request.resource.data)
                    && traceModification(request.resource.data, resource.data);
      allow delete: if false;
    }

    // Un modèle appartient à une marque, et la marque doit exister : un modèle
    // orphelin apparaîtrait dans une liste de choix sans qu'on sache de quelle
    // marque il est.
    function modeleValide(donnees) {
      return donnees.keys().hasOnly(['nom', 'actif', 'marqueId'].concat(champsAudit()))
             && donnees.keys().hasAll(['nom', 'actif', 'marqueId'].concat(champsAudit()))
             && nomBorne(donnees.nom)
             && donnees.actif is bool
             && donnees.marqueId is string
             && exists(/databases/$(database)/documents/marques/$(donnees.marqueId));
    }

    match /modeles/{id} {
      allow read: if connecte();
      allow create: if estResponsable()
                    && modeleValide(request.resource.data)
                    && traceCreation(request.resource.data);
      allow update: if estResponsable()
                    && modeleValide(request.resource.data)
                    && request.resource.data.marqueId == resource.data.marqueId
                    && traceModification(request.resource.data, resource.data);
      allow delete: if false;
    }

    // Le champ « token » du cahier des charges n'est pas au contrat : il donne
    // accès à une page publique, et un secret ne se fabrique pas dans un
    // navigateur. Il viendra d'une Cloud Function en S15.
    function prestataireValide(donnees) {
      return donnees.keys().hasOnly(['nom', 'telephone', 'typesDocuments', 'actif'].concat(champsAudit()))
             && donnees.keys().hasAll(['nom', 'telephone', 'typesDocuments', 'actif'].concat(champsAudit()))
             && nomBorne(donnees.nom)
             && donnees.telephone is string
             && donnees.telephone.size() > 0
             && donnees.telephone.size() <= 40
             && donnees.typesDocuments is list
             && donnees.typesDocuments.size() > 0
             && donnees.typesDocuments.hasOnly(['carte_grise', 'plaque'])
             && donnees.actif is bool;
    }

    match /prestataires/{id} {
      allow read: if connecte();
      allow create: if estResponsable()
                    && prestataireValide(request.resource.data)
                    && traceCreation(request.resource.data);
      allow update: if estResponsable()
                    && prestataireValide(request.resource.data)
                    && traceModification(request.resource.data, resource.data);
      allow delete: if false;
    }

    // Le logo est une image encodée dans le document : c'est ce qui permet à un
    // reçu de s'imprimer sans réseau. On borne sa taille — Firestore plafonne à
    // 1 Mio par document, et ce document est relu à chaque ouverture.
    function logoValide(valeur) {
      return valeur == null
             || (valeur is string && valeur.size() <= 200000 && valeur[0:11] == 'data:image/');
    }

    function entrepriseValide(donnees) {
      return donnees.keys().hasOnly(['nom', 'adresse', 'telephone', 'telephone2', 'identifiant',
                                     'logo', 'seuilInactiviteTranches',
                                     'updatedAt', 'updatedBy', 'updatedByName'])
             && donnees.nom is string
             && donnees.nom.size() > 0
             && donnees.nom.size() <= 80
             && texteBorne(donnees.adresse, 200)
             && texteBorne(donnees.telephone, 40)
             && texteBorne(donnees.telephone2, 40)
             && texteBorne(donnees.identifiant, 40)
             && logoValide(donnees.logo)
             // Le seuil d'inactivité des tranches (S9, §6.3). Facultatif :
             // les fiches saisies avant S9 n'en ont pas, et le défaut de
             // trente jours prend le relais côté application.
             && (!donnees.keys().hasAny(['seuilInactiviteTranches'])
                 || (donnees.seuilInactiviteTranches is int
                     && donnees.seuilInactiviteTranches >= 1
                     && donnees.seuilInactiviteTranches <= 365))
             && donnees.updatedAt == request.time
             && donnees.updatedBy == request.auth.uid
             && texteBorne(donnees.updatedByName, 200);
    }

    match /entreprise/{document} {
      allow read: if connecte();
      allow create, update: if estResponsable()
                            && document == 'profil'
                            && entrepriseValide(request.resource.data);
      allow delete: if false;
    }

    // --- Stock motos (S5) ---------------------------------------------------
    // Le document est coupé en deux, et la coupure est la règle de sécurité
    // elle-même : `motos/{id}` est lisible par le gérant de la boutique,
    // `motos/{id}/prive/cout` par le seul responsable. Firestore ne sait pas
    // masquer un champ ; c'est la seule façon de tenir le §8 du cahier des
    // charges — la marge est réservée au responsable — tout en laissant le
    // gérant lire la moto pour la vendre (D2).
    //
    // Le gérant écrit le coût sans jamais pouvoir le relire (D4) : une moto qui
    // arrive au comptoir doit se saisir sans attendre le responsable.

    function estGerantDe(boutiqueId) {
      return connecte() && role() == 'gerant' && request.auth.token.boutiqueId == boutiqueId;
    }

    function montantValide(valeur) {
      return valeur is int && valeur >= 0 && valeur <= 1000000000;
    }

    function motoValide(donnees) {
      return donnees.keys().hasOnly(['boutiqueId', 'etat', 'marqueId', 'modeleId', 'couleur',
                                     'annee', 'numeroChassis', 'numeroMoteur',
                                     'prixVenteConseille', 'provenanceId', 'papiersFournis',
                                     'photos', 'statut', 'dateEntree'].concat(champsAudit()))
             && donnees.keys().hasAll(['boutiqueId', 'etat', 'marqueId', 'modeleId',
                                       'numeroChassis', 'provenanceId', 'photos', 'statut',
                                       'dateEntree'].concat(champsAudit()))
             && donnees.boutiqueId is string
             && donnees.etat in ['neuve', 'occasion']
             && donnees.statut in ['en_stock', 'reservee', 'vendue', 'transferee']
             && donnees.marqueId is string
             && donnees.marqueId.size() > 0
             && donnees.modeleId is string
             && donnees.modeleId.size() > 0
             && donnees.provenanceId is string
             && donnees.provenanceId.size() > 0
             && donnees.numeroChassis is string
             && donnees.numeroChassis.size() > 0
             && donnees.numeroChassis.size() <= 32
             && donnees.numeroChassis.matches('^[A-Z0-9]+$')
             && texteBorne(donnees.numeroMoteur, 32)
             && texteBorne(donnees.couleur, 60)
             && (donnees.annee == null
                 || (donnees.annee is int && donnees.annee >= 1950 && donnees.annee <= 2100))
             && (donnees.prixVenteConseille == null || montantValide(donnees.prixVenteConseille))
             && donnees.papiersFournis is list
             && donnees.papiersFournis.size() <= 20
             // Les photos arrivent avec S19 : la liste existe et reste vide.
             && donnees.photos is list
             && donnees.photos.size() == 0
             // La date d'entrée vient de l'appareil (D38), on la borne seulement
             // contre une horloge déréglée.
             && donnees.dateEntree is timestamp
             && donnees.dateEntree <= request.time + duration.value(1, 'd');
    }

    match /motos/{motoId} {
      allow read: if estResponsable() || estGerantDe(resource.data.boutiqueId);

      allow create: if motoValide(request.resource.data)
                    && traceCreation(request.resource.data)
                    && request.resource.data.statut == 'en_stock'
                    && (estResponsable() || estGerantDe(request.resource.data.boutiqueId));

      // La boutique d'une moto ne change pas ici : c'est un transfert, et le
      // transfert a sa propre spec (S17) parce qu'il laisse une trace.
      allow update: if motoValide(request.resource.data)
                    && traceModification(request.resource.data, resource.data)
                    && request.resource.data.boutiqueId == resource.data.boutiqueId
                    && (estResponsable() || estGerantDe(resource.data.boutiqueId));

      allow delete: if false;
    }

    // Le coût. Le `boutiqueId` y est répété : au sein d'un même lot d'écriture,
    // les règles évaluent chaque document contre l'état d'avant, donc la moto
    // parente n'existe pas encore quand son coût est validé. On vérifie donc le
    // claim directement, et le parent en plus dès qu'il existe.
    //
    // Limite assumée : les règles ne savent pas parcourir une liste, donc ni la
    // forme de chaque ligne de frais ni l'égalité coutTotal = prixAchat + frais
    // ne sont vérifiées ici. C'est le domaine qui les tient, et le responsable
    // voit le détail à côté du total.
    function coutValide(donnees) {
      return donnees.keys().hasOnly(['boutiqueId', 'prixAchat', 'fraisEntree', 'coutTotal',
                                     'updatedAt', 'updatedBy', 'updatedByName'])
             && donnees.keys().hasAll(['boutiqueId', 'prixAchat', 'fraisEntree', 'coutTotal',
                                       'updatedAt', 'updatedBy', 'updatedByName'])
             && donnees.boutiqueId is string
             && montantValide(donnees.prixAchat)
             && montantValide(donnees.coutTotal)
             && donnees.fraisEntree is list
             && donnees.fraisEntree.size() <= 20
             && donnees.updatedAt == request.time
             && donnees.updatedBy == request.auth.uid
             && texteBorne(donnees.updatedByName, 200);
    }

    function boutiqueDeLaMoto(motoId) {
      return get(/databases/$(database)/documents/motos/$(motoId)).data.boutiqueId;
    }

    match /motos/{motoId}/prive/{section} {
      allow read: if estResponsable();

      allow create, update: if section == 'cout'
                            && coutValide(request.resource.data)
                            && (estResponsable()
                                || estGerantDe(request.resource.data.boutiqueId))
                            && (!exists(/databases/$(database)/documents/motos/$(motoId))
                                || boutiqueDeLaMoto(motoId) == request.resource.data.boutiqueId);

      allow delete: if false;
    }

    // --- Clients (S6) -------------------------------------------------------
    // Le fichier clients est **commun à toutes les boutiques** (D16) : pas de
    // `boutiqueId`, donc pas de cloisonnement. C'est la seule collection dans
    // ce cas, et c'est un arbitrage assumé — un client est une personne, pas
    // une opération, et le retrouver d'une boutique à l'autre évite de le
    // ressaisir et de couper son historique en deux.
    //
    // Ce qu'un gérant voit ainsi : des noms et des numéros. Ce qu'il ne voit
    // toujours pas : les ventes, les montants et les dossiers des autres
    // boutiques, qui restent cloisonnés ailleurs dans ce fichier.

    function clientValide(donnees) {
      return donnees.keys().hasOnly(['nom', 'nomNormalise', 'telephone', 'telephoneNormalise',
                                     'telephone2', 'adresse', 'note'].concat(champsAudit()))
             && donnees.keys().hasAll(['nom', 'nomNormalise', 'telephone', 'telephoneNormalise',
                                       'telephone2', 'adresse', 'note'].concat(champsAudit()))
             && donnees.nom is string
             && donnees.nom.size() > 0
             && donnees.nom.size() <= 80
             && donnees.nomNormalise is string
             && donnees.nomNormalise.size() <= 80
             && donnees.telephone is string
             && donnees.telephone.size() > 0
             && donnees.telephone.size() <= 32
             && donnees.telephoneNormalise is string
             && donnees.telephoneNormalise.size() > 0
             && donnees.telephoneNormalise.size() <= 32
             && texteBorne(donnees.telephone2, 32)
             && texteBorne(donnees.adresse, 200)
             && texteBorne(donnees.note, 300);
    }

    match /clients/{clientId} {
      allow read: if connecte();

      allow create: if connecte()
                    && clientValide(request.resource.data)
                    && traceCreation(request.resource.data);

      allow update: if connecte()
                    && clientValide(request.resource.data)
                    && traceModification(request.resource.data, resource.data);

      // Un client est cité par des ventes : on le corrige, on ne l'efface pas.
      allow delete: if false;
    }

    // --- Ventes de motos (S8) ----------------------------------------------
    // Le document que le gérant lit pour travailler. Ce qu'il ne contient pas
    // compte autant : le coût figé et la marge vivent dans
    // `ventesMotos/{id}/prive/marge`, fermé en écriture à TOUT navigateur et
    // ouvert en lecture au seul responsable (D2, D51). Il est rempli par un
    // déclencheur via le SDK Admin, qui ne passe pas par ces règles — c'est ce
    // qui rend la marge infalsifiable et pas seulement invisible.
    //
    // Aucune mise à jour n'est permise ici. S8 crée, et c'est tout : les
    // agrégats de paiement s'ouvriront en S9, le cycle des documents en S11,
    // l'annulation en S25. Ouvrir d'avance ce qu'aucun écran n'utilise, c'est
    // ouvrir sans test (SECURITY.md §0).

    function numeroDOrigine(valeur) {
      // Jamais de suffixe à la création : un appareil n'émet que des numéros
      // d'origine, le `-B` est la réponse du serveur à une collision (D5).
      return valeur is string && valeur.matches('^[A-Z]{3}-[0-9]{4}-[0-9]{4,}$');
    }

    function listeBornee(valeur, maximum) {
      return valeur is list && valeur.size() <= maximum;
    }

    function dateAppareil(valeur) {
      // La date métier vient de l'appareil (D38). On ne peut pas vérifier une
      // date passée, mais on peut refuser l'absurde : une horloge en avance.
      return valeur is timestamp && valeur <= request.time + duration.value(1, 'd');
    }

    function venteValide(donnees) {
      return donnees.keys().hasOnly(['numero', 'numeroInitial', 'boutiqueId', 'motoId', 'clientId',
                                     'date', 'prixConvenu', 'modePaiement', 'inclus', 'nonInclus',
                                     'totalPaye', 'resteDu', 'statutPaiement', 'dernierVersementAt',
                                     'motoRemise', 'dateRemiseMoto', 'tokenSuivi',
                                     'lienSuiviEnvoyeAt', 'statutDossier',
                                     'dateClotureDossier'].concat(champsAudit()))
             && donnees.keys().hasAll(['numero', 'numeroInitial', 'boutiqueId', 'motoId', 'clientId',
                                       'date', 'prixConvenu', 'modePaiement', 'inclus', 'nonInclus',
                                       'totalPaye', 'resteDu', 'statutPaiement', 'dernierVersementAt',
                                       'motoRemise', 'dateRemiseMoto', 'tokenSuivi',
                                       'lienSuiviEnvoyeAt', 'statutDossier',
                                       'dateClotureDossier'].concat(champsAudit()))
             // Les deux numéros sont égaux à la création, et `numeroInitial` ne
             // bougera plus jamais : c'est la clé de rapprochement des doublons
             // (D44), et une clé qui bouge ne rapproche plus rien.
             && numeroDOrigine(donnees.numero)
             && donnees.numero == donnees.numeroInitial
             && donnees.boutiqueId is string
             && donnees.motoId is string
             && donnees.motoId.size() > 0
             && donnees.clientId is string
             && donnees.clientId.size() > 0
             && dateAppareil(donnees.date)
             && montantValide(donnees.prixConvenu)
             && donnees.prixConvenu > 0
             && donnees.modePaiement in ['comptant', 'credit', 'tranches']
             && listeBornee(donnees.inclus, 20)
             && listeBornee(donnees.nonInclus, 20)
             // L'arithmétique de la vente, vérifiée ici et pas seulement dans le
             // formulaire : c'est le seul endroit qu'un client modifié ne
             // contourne pas.
             && montantValide(donnees.totalPaye)
             && montantValide(donnees.resteDu)
             && donnees.totalPaye + donnees.resteDu == donnees.prixConvenu
             && donnees.statutPaiement == (donnees.resteDu == 0
                                           ? 'solde'
                                           : (donnees.totalPaye > 0 ? 'partiel' : 'impaye'))
             // Une vente au comptant est payée en entier, par définition (§6.2).
             && (donnees.modePaiement != 'comptant' || donnees.resteDu == 0)
             // Crédit et comptant livrent la moto ; les tranches la retiennent.
             && donnees.motoRemise is bool
             && donnees.motoRemise == (donnees.modePaiement != 'tranches')
             && (donnees.motoRemise ? dateAppareil(donnees.dateRemiseMoto)
                                    : donnees.dateRemiseMoto == null)
             && (donnees.totalPaye > 0 ? dateAppareil(donnees.dernierVersementAt)
                                       : donnees.dernierVersementAt == null)
             // 32 octets en base64url : le secret qui ouvre la page de suivi (D6).
             && donnees.tokenSuivi is string
             && donnees.tokenSuivi.size() == 43
             && donnees.tokenSuivi.matches('^[A-Za-z0-9_-]+$')
             && donnees.lienSuiviEnvoyeAt == null
             && donnees.statutDossier == 'ouvert'
             && donnees.dateClotureDossier == null;
    }

    function peutVendrePour(boutiqueId) {
      return estResponsable() || estGerantDe(boutiqueId);
    }

    // --- Versements et suivi des paiements (S9) ----------------------------
    // S8 avait fermé ce document en modification. S9 y perce une porte
    // étroite : deux gestes passent, et tout le reste demeure immuable. Le
    // numéro, le prix, le mode de paiement, le client, la moto et le token de
    // suivi ne bougeront jamais depuis un navigateur.
    //
    // Ce qui NE passe toujours pas : corriger ou annuler un versement. C'est
    // une opération sensible sur de l'argent déjà encaissé et un reçu déjà
    // remis ; elle reste à S25, avec son historique (D58).

    function seulsChangent(champs) {
      // Les horodatages d'audit accompagnent toute modification : ils font
      // partie du geste, pas de ce qu'on autorise en plus.
      return request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(champs.concat(['updatedAt', 'updatedBy', 'updatedByName']));
    }

    // Un encaissement. `totalPaye` ne peut que MONTER : un total qui baisse est
    // soit une erreur, soit une annulation — et l'annulation est journalisée,
    // réservée au responsable, et n'existe pas encore (S25).
    //
    // Le plafond `totalPaye <= prixConvenu` interdit le trop-perçu depuis un
    // navigateur. Le déclencheur serveur, lui, ne passe pas par ces règles :
    // s'il constate une somme supérieure — deux appareils hors ligne ayant
    // encaissé chacun de leur côté — il l'écrit, et cette vente n'accepte plus
    // aucun versement, ce qui est exactement ce qu'on veut.
    function encaissementValideSurVente(donnees, ancien) {
      return seulsChangent(['totalPaye', 'resteDu', 'statutPaiement', 'dernierVersementAt'])
             && montantValide(donnees.totalPaye)
             && montantValide(donnees.resteDu)
             && donnees.totalPaye > ancien.totalPaye
             && donnees.totalPaye <= donnees.prixConvenu
             && donnees.resteDu == donnees.prixConvenu - donnees.totalPaye
             && donnees.statutPaiement == (donnees.resteDu == 0
                                           ? 'solde'
                                           : (donnees.totalPaye > 0 ? 'partiel' : 'impaye'))
             && dateAppareil(donnees.dernierVersementAt);
    }

    // La remise de la moto au terme des tranches (§6.2) : le seul moment où
    // l'argent détenu pour le compte d'un client devient une recette.
    //
    // La condition tient à `resteDu == 0` sur l'état d'AVANT. Cet agrégat est
    // un cache d'affichage (D56), mais il ne peut se tromper que dans le bon
    // sens : `totalPaye` n'additionne que des versements réels, donc il reste
    // inférieur ou égal à la vérité, donc `resteDu` reste supérieur ou égal.
    // Un reste dû nul l'est donc vraiment.
    function remiseMotoValide(donnees, ancien) {
      return seulsChangent(['motoRemise', 'dateRemiseMoto'])
             && ancien.modePaiement == 'tranches'
             && ancien.motoRemise == false
             && ancien.resteDu == 0
             && donnees.motoRemise == true
             && dateAppareil(donnees.dateRemiseMoto);
    }

    match /ventesMotos/{venteId} {
      allow read: if peutVendrePour(resource.data.boutiqueId);

      allow create: if venteValide(request.resource.data)
                    && traceCreation(request.resource.data)
                    && peutVendrePour(request.resource.data.boutiqueId);

      allow update: if peutVendrePour(resource.data.boutiqueId)
                    && traceModification(request.resource.data, resource.data)
                    && (encaissementValideSurVente(request.resource.data, resource.data)
                        || remiseMotoValide(request.resource.data, resource.data));

      // Une vente ne se supprime pas : elle s'annule, et l'annulation laisse
      // une trace. S25.
      allow delete: if false;
    }

    // L'historique d'une vente (§3.5). Une seule entrée y est écrite
    // aujourd'hui — la remise de la moto — parce que c'est le seul changement
    // d'état dont la trace disparaîtrait autrement : `updatedBy` sur la vente
    // sera écrasé par la prochaine écriture. Un versement, lui, EST sa propre
    // trace.
    function historiqueValide(donnees, venteId) {
      return donnees.keys().hasOnly(['boutiqueId', 'venteId', 'evenement',
                                     'date'].concat(champsAudit()))
             && donnees.keys().hasAll(['boutiqueId', 'venteId', 'evenement',
                                       'date'].concat(champsAudit()))
             && donnees.boutiqueId is string
             && donnees.venteId == venteId
             && donnees.evenement == 'remise_moto'
             && dateAppareil(donnees.date);
    }

    match /ventesMotos/{venteId}/historique/{entree} {
      allow read: if peutVendrePour(resource.data.boutiqueId);
      allow create: if historiqueValide(request.resource.data, venteId)
                    && traceCreation(request.resource.data)
                    && peutVendrePour(request.resource.data.boutiqueId);
      // Un journal ne se réécrit pas. C'est ce qui en fait un journal.
      allow update, delete: if false;
    }

    // La marge : lecture réservée au responsable, écriture refusée à tout le
    // monde. Seul le déclencheur `figerMargeVente` la remplit, et il passe par
    // le SDK Admin — hors de portée de ces règles, donc hors de portée d'un
    // navigateur.
    match /ventesMotos/{venteId}/prive/{section} {
      allow read: if estResponsable();
      allow write: if false;
    }

    // Le dossier. Le `boutiqueId` y est répété pour deux raisons : dans un lot,
    // les règles évaluent chaque document contre l'état d'AVANT — la vente
    // parente n'existe donc pas encore quand son dossier est validé — et une
    // requête de groupe de collections ne peut filtrer que sur les champs du
    // document lui-même. Même montage qu'en S5 sur le coût d'une moto.
    //
    // Le type est l'identifiant du document : deux cartes grises dans un même
    // dossier sont structurellement impossibles, sans qu'aucune règle ait à le
    // dire.
    function documentDossierValide(donnees, venteId, type) {
      return donnees.keys().hasOnly(['boutiqueId', 'venteId', 'type', 'statut'].concat(champsAudit()))
             && donnees.keys().hasAll(['boutiqueId', 'venteId', 'type', 'statut'].concat(champsAudit()))
             && donnees.boutiqueId is string
             && donnees.venteId == venteId
             && donnees.type == type
             && type in ['quittance', 'cmc', 'carte_grise', 'plaque']
             // S8 ouvre le dossier ; c'est S11 qui fera vivre les autres statuts.
             && donnees.statut == 'a_faire';
    }

    match /ventesMotos/{venteId}/documents/{type} {
      allow read: if peutVendrePour(resource.data.boutiqueId);
      allow create: if documentDossierValide(request.resource.data, venteId, type)
                    && traceCreation(request.resource.data)
                    && peutVendrePour(request.resource.data.boutiqueId);
      allow update, delete: if false;
    }

    // La lecture d'ensemble des dossiers, sur laquelle repose la liste des
    // ventes (§6.4). Une requête de groupe de collections n'emprunte PAS la
    // règle du chemin complet ci-dessus : il lui faut un chemin récursif, sinon
    // elle est refusée quoi qu'on autorise plus haut. La condition reste la
    // même — chacun ne lit que sa boutique.
    match /{chemin=**}/documents/{type} {
      allow read: if peutVendrePour(resource.data.boutiqueId);
    }

    // Les versements. S8 écrit celui du jour de la vente dans le lot de la
    // vente ; S9 ajoute les suivants. Aucun ne se modifie ni ne se supprime,
    // pour personne : un reçu remis à un client ne se retouche pas depuis un
    // écran. La correction et l'annulation sont à S25, journalisées.
    //
    // Le numéro du reçu dérive de celui de la vente, suivi du rang du versement
    // (D57) : `PTG-2608-0042/V2`. Ce n'est pas une seconde série de compteurs,
    // et c'est délibéré — un compteur nourri ailleurs que dans `ventesMotos`
    // serait invisible à un appareil neuf, qui refabriquerait les doublons que
    // le mécanisme existe pour éviter. Le suffixe `-B` d'une vente renumérotée
    // est admis : le reçu suit sa vente.
    function numeroRecu(valeur) {
      return valeur is string
             && valeur.matches('^[A-Z]{3}-[0-9]{4}-[0-9]{4,}(-[A-Z]+)?(/V[0-9]{1,4})?$');
    }

    function versementValide(donnees, venteId) {
      return donnees.keys().hasOnly(['boutiqueId', 'venteId', 'numeroRecu', 'date', 'montant',
                                     'moyenPaiement', 'reference',
                                     'encaissementId'].concat(champsAudit()))
             && donnees.keys().hasAll(['boutiqueId', 'venteId', 'numeroRecu', 'date', 'montant',
                                       'moyenPaiement', 'reference',
                                       'encaissementId'].concat(champsAudit()))
             && donnees.boutiqueId is string
             && donnees.venteId == venteId
             && numeroRecu(donnees.numeroRecu)
             && dateAppareil(donnees.date)
             && montantValide(donnees.montant)
             && donnees.montant > 0
             && donnees.moyenPaiement in ['especes', 'orange_money', 'moov_money', 'wave']
             && texteBorne(donnees.reference, 60)
             && donnees.encaissementId is string
             && donnees.encaissementId.size() > 0;
    }

    match /ventesMotos/{venteId}/versements/{versementId} {
      allow read: if peutVendrePour(resource.data.boutiqueId);
      allow create: if versementValide(request.resource.data, venteId)
                    && traceCreation(request.resource.data)
                    && peutVendrePour(request.resource.data.boutiqueId);
      allow update, delete: if false;
    }

    // La lecture d'ensemble des versements, sur laquelle reposent les trois
    // listes de suivi (§6.3) : elles additionnent les versements, jamais les
    // agrégats portés par les ventes (§3.4, D56). Comme pour les dossiers, une
    // requête de groupe de collections n'emprunte pas la règle du chemin
    // complet ci-dessus — il lui faut ce chemin récursif, à condition égale.
    match /{chemin=**}/versements/{versementId} {
      allow read: if peutVendrePour(resource.data.boutiqueId);
    }

    // La caisse. Rien ne lit encore ces documents — le journal et la clôture
    // sont post-MVP (S22) — mais l'argent qui entre aujourd'hui se trace
    // aujourd'hui : un journal comptable troué se répare par une migration, ce
    // qui coûte bien plus cher que ces quelques lignes (D53).
    function encaissementValide(donnees) {
      return donnees.keys().hasOnly(['boutiqueId', 'date', 'sens', 'montant', 'moyenPaiement',
                                     'origine', 'origineRefId', 'libelle',
                                     'categorieTranches'].concat(champsAudit()))
             && donnees.keys().hasAll(['boutiqueId', 'date', 'sens', 'montant', 'moyenPaiement',
                                       'origine', 'origineRefId', 'libelle',
                                       'categorieTranches'].concat(champsAudit()))
             && donnees.boutiqueId is string
             && dateAppareil(donnees.date)
             && donnees.sens in ['entree', 'sortie']
             && montantValide(donnees.montant)
             && donnees.montant > 0
             && donnees.moyenPaiement in ['especes', 'orange_money', 'moov_money', 'wave']
             && donnees.origine in ['vente_moto', 'versement', 'vente_piece', 'depense',
                                    'avance_prestataire', 'autre']
             && donnees.origineRefId is string
             && texteBorne(donnees.libelle, 120)
             // L'argent des tranches est un engagement, pas une recette, tant
             // que la moto dort au magasin (§6.2). Le drapeau se pose à
             // l'encaissement ; le retrouver après coup serait un cauchemar.
             && donnees.categorieTranches is bool;
    }

    match /encaissements/{encaissementId} {
      allow read: if peutVendrePour(resource.data.boutiqueId);
      allow create: if encaissementValide(request.resource.data)
                    && traceCreation(request.resource.data)
                    && peutVendrePour(request.resource.data.boutiqueId);
      // Une écriture de caisse ne se retouche pas : on la contre-passe. S22.
      allow update, delete: if false;
    }

    // --- Écritures de vérification de la synchronisation -------------------
    // Produites par l'écran /diagnostic. Sans valeur métier, jamais lues par
    // l'application, et réservées à une session ouverte.
    match /diagnostics/{essai} {
      allow read: if false;
      allow create: if connecte()
                    && request.resource.data.keys().hasOnly(['ecritA', 'origine'])
                    && request.resource.data.origine == 'diagnostic';
      allow update, delete: if false;
    }

    // Tout le reste est fermé tant qu'une spec ne l'ouvre pas explicitement.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
