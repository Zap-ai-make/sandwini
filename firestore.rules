rules_version = '2';

/*
  Règles Firestore.

  Principe non négociable, posé dès la première ligne : refus par défaut, et
  aucun accès direct pour un utilisateur non authentifié (SECURITY.md §1 et §4,
  prompt.md §16). Les pages publiques client et prestataire ne feront jamais
  d'exception ici : elles passeront par l'Admin SDK côté serveur.

  Chaque spec ajoute ses propres règles avec ses tests. S12 est la passe de
  durcissement d'ensemble — pas le moment où l'on commence à écrire ce fichier.
*/

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Fonctions d'aide -------------------------------------------------
    // Le rôle est lu dans le custom claim, jamais dans un document : un rôle
    // stocké dans une collection modifiable serait un rôle qu'on peut se
    // donner soi-même.

    function connecte() {
      return request.auth != null;
    }

    function role() {
      return request.auth.token.role;
    }

    function estResponsable() {
      return connecte() && role() == 'responsable';
    }

    // --- Comptes utilisateurs (S2) ---------------------------------------
    // `users/{uid}` est un **miroir** lisible du compte, pas la source des
    // droits. Personne ne l'écrit depuis un navigateur : seules les Cloud
    // Functions y touchent, via le SDK Admin qui ne passe pas par ces règles.
    // C'est ce qui rend structurellement impossible de se promouvoir
    // responsable ou de se rattacher à une autre boutique.
    match /users/{uid} {
      allow read: if estResponsable() || (connecte() && request.auth.uid == uid);
      allow create, update, delete: if false;
    }

    // --- Boutiques (S3) ---------------------------------------------------
    // L'identifiant du document EST le code de la boutique. Firestore ne sait
    // pas imposer l'unicité d'un champ ; en faire la clé la donne gratuitement,
    // et le code entre dans les numéros de reçus (D5) donc il ne bouge jamais.
    //
    // Le gérant ne lit que la sienne : c'est la seule dont il ait besoin, et en
    // cas de doute on expose le moins (SECURITY.md §0, cf. D7).

    function texteBorne(valeur, maximum) {
      return valeur is string && valeur.size() <= maximum;
    }

    function boutiqueValide(donnees, code) {
      return donnees.keys().hasOnly(['nom', 'code', 'adresse', 'telephone', 'actif',
                                     'createdAt', 'createdBy', 'createdByName',
                                     'updatedAt', 'updatedBy', 'updatedByName'])
             && donnees.keys().hasAll(['nom', 'code', 'adresse', 'telephone', 'actif',
                                       'createdAt', 'createdBy', 'createdByName',
                                       'updatedAt', 'updatedBy', 'updatedByName'])
             && donnees.code == code
             && donnees.code.matches('^[A-Z]{3}$')
             && donnees.nom is string
             && donnees.nom.size() > 0
             && donnees.nom.size() <= 80
             && texteBorne(donnees.adresse, 200)
             && texteBorne(donnees.telephone, 40)
             && texteBorne(donnees.createdByName, 200)
             && texteBorne(donnees.updatedByName, 200)
             && donnees.actif is bool
             && donnees.createdBy is string
             && donnees.updatedBy is string;
    }

    match /boutiques/{code} {
      allow read: if estResponsable()
                  || (connecte() && request.auth.token.boutiqueId == code);

      allow create: if estResponsable()
                    && boutiqueValide(request.resource.data, code)
                    && request.resource.data.createdAt == request.time
                    && request.resource.data.updatedAt == request.time
                    && request.resource.data.createdBy == request.auth.uid;

      // Le code et la date de création ne bougent pas. C'est aussi ce qui
      // empêche une « création » de recouvrir une boutique existante : le
      // formulaire enverrait un createdAt neuf, refusé ici.
      allow update: if estResponsable()
                    && boutiqueValide(request.resource.data, code)
                    && request.resource.data.code == resource.data.code
                    && request.resource.data.createdAt == resource.data.createdAt
                    && request.resource.data.createdBy == resource.data.createdBy
                    && request.resource.data.updatedAt == request.time
                    && request.resource.data.updatedBy == request.auth.uid;

      // Une boutique ne se supprime pas : des ventes et des numéros de reçus
      // portent son code. On la ferme, elle reste lisible.
      allow delete: if false;
    }

    // --- Référentiels et entreprise (S4) -----------------------------------
    // Tout le monde lit, seul le responsable écrit. Le gérant a besoin de ces
    // listes pour saisir une moto ou déposer un dossier, et des coordonnées de
    // l'entreprise pour imprimer un reçu — y compris hors ligne, d'où le fait
    // que le logo voyage dans le document plutôt que dans Storage (D35).
    //
    // Rien ne se supprime : une marque, une provenance, un prestataire sont
    // cités par des motos et des dossiers. On les désactive.

    function traceCreation(donnees) {
      return donnees.createdAt == request.time
             && donnees.updatedAt == request.time
             && donnees.createdBy == request.auth.uid
             && donnees.updatedBy == request.auth.uid
             && texteBorne(donnees.createdByName, 200)
             && texteBorne(donnees.updatedByName, 200);
    }

    function traceModification(donnees, ancien) {
      return donnees.updatedAt == request.time
             && donnees.updatedBy == request.auth.uid
             && texteBorne(donnees.updatedByName, 200)
             && donnees.createdAt == ancien.createdAt
             && donnees.createdBy == ancien.createdBy;
    }

    function champsAudit() {
      return ['createdAt', 'createdBy', 'createdByName', 'updatedAt', 'updatedBy', 'updatedByName'];
    }

    function nomBorne(valeur) {
      return valeur is string && valeur.size() > 0 && valeur.size() <= 60;
    }

    function referentielValide(donnees) {
      return donnees.keys().hasOnly(['nom', 'actif'].concat(champsAudit()))
             && donnees.keys().hasAll(['nom', 'actif'].concat(champsAudit()))
             && nomBorne(donnees.nom)
             && donnees.actif is bool;
    }

    // Les trois référentiels de même forme : un nom, un état. La liste est
    // explicite — ce n'est pas un joker sur les collections inconnues.
    match /{referentiel}/{id} {
      allow read: if connecte()
                  && referentiel in ['marques', 'provenances', 'typesFrais'];
      allow create: if estResponsable()
                    && referentiel in ['marques', 'provenances', 'typesFrais']
                    && referentielValide(request.resource.data)
                    && traceCreation(request.resource.data);
      allow update: if estResponsable()
                    && referentiel in ['marques', 'provenances', 'typesFrais']
                    && referentielValide(request.resource.data)
                    && traceModification(request.resource.data, resource.data);
      allow delete: if false;
    }

    // Un modèle appartient à une marque, et la marque doit exister : un modèle
    // orphelin apparaîtrait dans une liste de choix sans qu'on sache de quelle
    // marque il est.
    function modeleValide(donnees) {
      return donnees.keys().hasOnly(['nom', 'actif', 'marqueId'].concat(champsAudit()))
             && donnees.keys().hasAll(['nom', 'actif', 'marqueId'].concat(champsAudit()))
             && nomBorne(donnees.nom)
             && donnees.actif is bool
             && donnees.marqueId is string
             && exists(/databases/$(database)/documents/marques/$(donnees.marqueId));
    }

    match /modeles/{id} {
      allow read: if connecte();
      allow create: if estResponsable()
                    && modeleValide(request.resource.data)
                    && traceCreation(request.resource.data);
      allow update: if estResponsable()
                    && modeleValide(request.resource.data)
                    && request.resource.data.marqueId == resource.data.marqueId
                    && traceModification(request.resource.data, resource.data);
      allow delete: if false;
    }

    // Le champ « token » du cahier des charges n'est pas au contrat : il donne
    // accès à une page publique, et un secret ne se fabrique pas dans un
    // navigateur. Il viendra d'une Cloud Function en S15.
    function prestataireValide(donnees) {
      return donnees.keys().hasOnly(['nom', 'telephone', 'typesDocuments', 'actif'].concat(champsAudit()))
             && donnees.keys().hasAll(['nom', 'telephone', 'typesDocuments', 'actif'].concat(champsAudit()))
             && nomBorne(donnees.nom)
             && donnees.telephone is string
             && donnees.telephone.size() > 0
             && donnees.telephone.size() <= 40
             && donnees.typesDocuments is list
             && donnees.typesDocuments.size() > 0
             && donnees.typesDocuments.hasOnly(['carte_grise', 'plaque'])
             && donnees.actif is bool;
    }

    match /prestataires/{id} {
      allow read: if connecte();
      allow create: if estResponsable()
                    && prestataireValide(request.resource.data)
                    && traceCreation(request.resource.data);
      allow update: if estResponsable()
                    && prestataireValide(request.resource.data)
                    && traceModification(request.resource.data, resource.data);
      allow delete: if false;
    }

    // Le logo est une image encodée dans le document : c'est ce qui permet à un
    // reçu de s'imprimer sans réseau. On borne sa taille — Firestore plafonne à
    // 1 Mio par document, et ce document est relu à chaque ouverture.
    function logoValide(valeur) {
      return valeur == null
             || (valeur is string && valeur.size() <= 200000 && valeur[0:11] == 'data:image/');
    }

    function entrepriseValide(donnees) {
      return donnees.keys().hasOnly(['nom', 'adresse', 'telephone', 'telephone2', 'identifiant',
                                     'logo', 'updatedAt', 'updatedBy', 'updatedByName'])
             && donnees.nom is string
             && donnees.nom.size() > 0
             && donnees.nom.size() <= 80
             && texteBorne(donnees.adresse, 200)
             && texteBorne(donnees.telephone, 40)
             && texteBorne(donnees.telephone2, 40)
             && texteBorne(donnees.identifiant, 40)
             && logoValide(donnees.logo)
             && donnees.updatedAt == request.time
             && donnees.updatedBy == request.auth.uid
             && texteBorne(donnees.updatedByName, 200);
    }

    match /entreprise/{document} {
      allow read: if connecte();
      allow create, update: if estResponsable()
                            && document == 'profil'
                            && entrepriseValide(request.resource.data);
      allow delete: if false;
    }

    // --- Stock motos (S5) ---------------------------------------------------
    // Le document est coupé en deux, et la coupure est la règle de sécurité
    // elle-même : `motos/{id}` est lisible par le gérant de la boutique,
    // `motos/{id}/prive/cout` par le seul responsable. Firestore ne sait pas
    // masquer un champ ; c'est la seule façon de tenir le §8 du cahier des
    // charges — la marge est réservée au responsable — tout en laissant le
    // gérant lire la moto pour la vendre (D2).
    //
    // Le gérant écrit le coût sans jamais pouvoir le relire (D4) : une moto qui
    // arrive au comptoir doit se saisir sans attendre le responsable.

    function estGerantDe(boutiqueId) {
      return connecte() && role() == 'gerant' && request.auth.token.boutiqueId == boutiqueId;
    }

    function montantValide(valeur) {
      return valeur is int && valeur >= 0 && valeur <= 1000000000;
    }

    function motoValide(donnees) {
      return donnees.keys().hasOnly(['boutiqueId', 'etat', 'marqueId', 'modeleId', 'couleur',
                                     'annee', 'numeroChassis', 'numeroMoteur',
                                     'prixVenteConseille', 'provenanceId', 'papiersFournis',
                                     'photos', 'statut', 'dateEntree'].concat(champsAudit()))
             && donnees.keys().hasAll(['boutiqueId', 'etat', 'marqueId', 'modeleId',
                                       'numeroChassis', 'provenanceId', 'photos', 'statut',
                                       'dateEntree'].concat(champsAudit()))
             && donnees.boutiqueId is string
             && donnees.etat in ['neuve', 'occasion']
             && donnees.statut in ['en_stock', 'reservee', 'vendue', 'transferee']
             && donnees.marqueId is string
             && donnees.marqueId.size() > 0
             && donnees.modeleId is string
             && donnees.modeleId.size() > 0
             && donnees.provenanceId is string
             && donnees.provenanceId.size() > 0
             && donnees.numeroChassis is string
             && donnees.numeroChassis.size() > 0
             && donnees.numeroChassis.size() <= 32
             && donnees.numeroChassis.matches('^[A-Z0-9]+$')
             && texteBorne(donnees.numeroMoteur, 32)
             && texteBorne(donnees.couleur, 60)
             && (donnees.annee == null
                 || (donnees.annee is int && donnees.annee >= 1950 && donnees.annee <= 2100))
             && (donnees.prixVenteConseille == null || montantValide(donnees.prixVenteConseille))
             && donnees.papiersFournis is list
             && donnees.papiersFournis.size() <= 20
             // Les photos arrivent avec S19 : la liste existe et reste vide.
             && donnees.photos is list
             && donnees.photos.size() == 0
             // La date d'entrée vient de l'appareil (D38), on la borne seulement
             // contre une horloge déréglée.
             && donnees.dateEntree is timestamp
             && donnees.dateEntree <= request.time + duration.value(1, 'd');
    }

    match /motos/{motoId} {
      allow read: if estResponsable() || estGerantDe(resource.data.boutiqueId);

      allow create: if motoValide(request.resource.data)
                    && traceCreation(request.resource.data)
                    && request.resource.data.statut == 'en_stock'
                    && (estResponsable() || estGerantDe(request.resource.data.boutiqueId));

      // La boutique d'une moto ne change pas ici : c'est un transfert, et le
      // transfert a sa propre spec (S17) parce qu'il laisse une trace.
      allow update: if motoValide(request.resource.data)
                    && traceModification(request.resource.data, resource.data)
                    && request.resource.data.boutiqueId == resource.data.boutiqueId
                    && (estResponsable() || estGerantDe(resource.data.boutiqueId));

      allow delete: if false;
    }

    // Le coût. Le `boutiqueId` y est répété : au sein d'un même lot d'écriture,
    // les règles évaluent chaque document contre l'état d'avant, donc la moto
    // parente n'existe pas encore quand son coût est validé. On vérifie donc le
    // claim directement, et le parent en plus dès qu'il existe.
    //
    // Limite assumée : les règles ne savent pas parcourir une liste, donc ni la
    // forme de chaque ligne de frais ni l'égalité coutTotal = prixAchat + frais
    // ne sont vérifiées ici. C'est le domaine qui les tient, et le responsable
    // voit le détail à côté du total.
    function coutValide(donnees) {
      return donnees.keys().hasOnly(['boutiqueId', 'prixAchat', 'fraisEntree', 'coutTotal',
                                     'updatedAt', 'updatedBy', 'updatedByName'])
             && donnees.keys().hasAll(['boutiqueId', 'prixAchat', 'fraisEntree', 'coutTotal',
                                       'updatedAt', 'updatedBy', 'updatedByName'])
             && donnees.boutiqueId is string
             && montantValide(donnees.prixAchat)
             && montantValide(donnees.coutTotal)
             && donnees.fraisEntree is list
             && donnees.fraisEntree.size() <= 20
             && donnees.updatedAt == request.time
             && donnees.updatedBy == request.auth.uid
             && texteBorne(donnees.updatedByName, 200);
    }

    function boutiqueDeLaMoto(motoId) {
      return get(/databases/$(database)/documents/motos/$(motoId)).data.boutiqueId;
    }

    match /motos/{motoId}/prive/{section} {
      allow read: if estResponsable();

      allow create, update: if section == 'cout'
                            && coutValide(request.resource.data)
                            && (estResponsable()
                                || estGerantDe(request.resource.data.boutiqueId))
                            && (!exists(/databases/$(database)/documents/motos/$(motoId))
                                || boutiqueDeLaMoto(motoId) == request.resource.data.boutiqueId);

      allow delete: if false;
    }

    // --- Clients (S6) -------------------------------------------------------
    // Le fichier clients est **commun à toutes les boutiques** (D16) : pas de
    // `boutiqueId`, donc pas de cloisonnement. C'est la seule collection dans
    // ce cas, et c'est un arbitrage assumé — un client est une personne, pas
    // une opération, et le retrouver d'une boutique à l'autre évite de le
    // ressaisir et de couper son historique en deux.
    //
    // Ce qu'un gérant voit ainsi : des noms et des numéros. Ce qu'il ne voit
    // toujours pas : les ventes, les montants et les dossiers des autres
    // boutiques, qui restent cloisonnés ailleurs dans ce fichier.

    function clientValide(donnees) {
      return donnees.keys().hasOnly(['nom', 'nomNormalise', 'telephone', 'telephoneNormalise',
                                     'telephone2', 'adresse', 'note'].concat(champsAudit()))
             && donnees.keys().hasAll(['nom', 'nomNormalise', 'telephone', 'telephoneNormalise',
                                       'telephone2', 'adresse', 'note'].concat(champsAudit()))
             && donnees.nom is string
             && donnees.nom.size() > 0
             && donnees.nom.size() <= 80
             && donnees.nomNormalise is string
             && donnees.nomNormalise.size() <= 80
             && donnees.telephone is string
             && donnees.telephone.size() > 0
             && donnees.telephone.size() <= 32
             && donnees.telephoneNormalise is string
             && donnees.telephoneNormalise.size() > 0
             && donnees.telephoneNormalise.size() <= 32
             && texteBorne(donnees.telephone2, 32)
             && texteBorne(donnees.adresse, 200)
             && texteBorne(donnees.note, 300);
    }

    match /clients/{clientId} {
      allow read: if connecte();

      allow create: if connecte()
                    && clientValide(request.resource.data)
                    && traceCreation(request.resource.data);

      allow update: if connecte()
                    && clientValide(request.resource.data)
                    && traceModification(request.resource.data, resource.data);

      // Un client est cité par des ventes : on le corrige, on ne l'efface pas.
      allow delete: if false;
    }

    // --- Écritures de vérification de la synchronisation -------------------
    // Produites par l'écran /diagnostic. Sans valeur métier, jamais lues par
    // l'application, et réservées à une session ouverte.
    match /diagnostics/{essai} {
      allow read: if false;
      allow create: if connecte()
                    && request.resource.data.keys().hasOnly(['ecritA', 'origine'])
                    && request.resource.data.origine == 'diagnostic';
      allow update, delete: if false;
    }

    // Tout le reste est fermé tant qu'une spec ne l'ouvre pas explicitement.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
