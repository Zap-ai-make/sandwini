rules_version = '2';

// Refus par defaut. Le seul fichier prevu au MVP est le logo de l'entreprise,
// televerse par le responsable : sa regle arrive avec S4, avec la verification
// du type reel et de la taille (SECURITY.md SS5).
service firebase.storage {
  match /b/{bucket}/o {
    // Les scans de la quittance et du CMC d'une moto (S11, D66).
    //
    // La lecture est reservee aux comptes connectes : ces papiers portent des
    // identites de clients. L'ecriture verifie le type reel et la taille — un
    // fichier de 40 Mo envoye depuis un telephone en 3G ne part jamais, et un
    // executable renomme en .jpg n'a rien a faire ici (SECURITY.md SS5).
    //
    // Le cloisonnement par boutique n'est pas exprimable ici : les regles
    // Storage ne savent pas lire un document Firestore. Le chemin porte donc
    // l'identifiant de la moto, qui n'est pas devinable, et Firestore reste
    // seul juge de qui voit quelle moto.
    match /motos/{motoId}/papiers/{fichier} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/(jpeg|png|webp)|application/pdf');
    }

    match /{chemin=**} {
      allow read, write: if false;
    }
  }
}
